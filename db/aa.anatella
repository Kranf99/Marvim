<sql>
SELECT a.*, ud.rights as rights, a.superadmin from dbu.Users a LEFT JOIN userDepartmentRights ud ON ud.idUser=a.id WHERE a.deleted=0 AND (a.superadmin=1 OR (1=1 and COALESCE(ud.rights,16)>=8)) ORDER BY name ASC, id ASC, rights DESC
</sql>
