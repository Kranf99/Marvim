<R idx='2107' x='588' y='384' finalize='1' middleWorkStart='43' udpt='1' id='My_R_KMEANS'
  orignalId='R_KMEANS'
  longName='K-Means Clustering'
 crypted='1'
  isVariableNPinIn='1'
  isVariableNPinOut='1'
  nPinInMax='2'
  nPinOutMax='4'
  le='1765465709124'
  abortOnMissingColumn='0'
  shape='4'
  color='#d4ffe8'
  keywords='kmeans k-mean clustering discovery segmentation'
  image='/R_KMEANS.svg'
  author='Daniel Soto Zeevaert'
  revision='0.39'
  tags='375_R Discovery Analytics'
  pdfDestination='5_13_3_k_means_clustering__ac'>
<Description>
&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;MS Shell Dlg 2&apos;; font-size:14px; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Input Pins:&lt;br /&gt;0: Main Table&lt;br /&gt;1: Variable List&lt;br /&gt;&lt;br /&gt;Output Pins:&lt;br /&gt;0: Table with cluster assignment&lt;br /&gt;1: Cluster Centers&lt;br /&gt;2: WSS&lt;br /&gt;3: Output File Information&lt;br /&gt;&lt;br /&gt;References:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Forgy, E. W. (1965) Cluster analysis of multivariate data: efficiency vs interpretability of classifications. &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Hartigan, J. A. and Wong, M. A. (1979). A K-means clustering algorithm. Applied Statistics&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Lloyd, S. P. (1957, 1982) Least squares quantization in PCM. Technical Note, Bell Laboratories. Published in 1982 in IEEE Transactions on Information Theory&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;MacQueen, J. (1967) Some methods for classification and analysis of multivariate observations. In &amp;quot;Proceedings of the Fifth Berkeley Symposium on Mathematical Statistics and Probability&amp;quot; ; eds L. M. Le Cam &amp;amp; J. Neyman, ; pp. 281–297. Berkeley, CA: University of California Press. &lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;
</Description>
<Parameters>
  <Parameter id='mytable' text='whole table' type='allcolumns'></Parameter>
  <Parameter id='Predictors' text='Variables to include in Cluster Solution' type='manycolumns'><meta>0</meta><data><c>pY_dmin</c><c>pY_dmax</c><c>Q1</c><c>Median</c><c>Q3</c></data></Parameter>
  <Parameter id='idxMethod' text='ALGO: Method' type='combobox'><meta>&lt;i&gt;Hartigan-Wong&lt;/i&gt;&lt;i&gt;Lloyd&lt;/i&gt;&lt;i&gt;Forgy&lt;/i&gt;&lt;i&gt;MacQueen&lt;/i&gt;</meta><data>0</data></Parameter>
  <Parameter id='idwss' text='ALGO: WSS Optimal Number Selection' type='combobox'><meta>&lt;i&gt;Do not compute&lt;/i&gt;&lt;i&gt;Compute and Display Only&lt;/i&gt;&lt;i&gt;Set with Elbow&lt;/i&gt;&lt;i&gt;Set with Silhouette&lt;/i&gt;</meta><data>0</data></Parameter>
  <Parameter id='idxScale' text='ALGO: Scale Matrix before clustering?' type='bool'>0</Parameter>
  <Parameter id='idxSeed' text='ALGO: Seed' type='double'>0</Parameter>
  <Parameter id='idxSegNum' text='ALGO: Number of Segments' type='double'>30</Parameter>
  <Parameter id='idxMax' text='ALGO: Maximum number of iterations' type='double'>500</Parameter>
  <Parameter id='idxStart' text='ALGO: Number of start' type='double'>15</Parameter>
  <Parameter id='idxMissing' text='ALGO: Numerical Missing Values Inputation' type='combobox'><meta>&lt;i&gt;Ignore&lt;/i&gt;&lt;i&gt;Replace by Mean&lt;/i&gt;&lt;i&gt;Predictive Mean Matching&lt;/i&gt;&lt;i&gt;Logistic Regression&lt;/i&gt;&lt;i&gt;Polynomial Regression&lt;/i&gt;&lt;i&gt;Proportional Odds Model&lt;/i&gt;&lt;i&gt;Cart&lt;/i&gt;</meta><data>1</data></Parameter>
  <Parameter id='idxName' text='OUT: Cluster Name' type='string'>K-Means Clusters</Parameter>
  <Parameter id='idxPlot' text='CHT: Plot Results?' type='combobox'><meta>&lt;i&gt;No Plot&lt;/i&gt;&lt;i&gt;Plot first 2 PCA&lt;/i&gt;</meta><data>1</data></Parameter>
  <Parameter id='idxDensity' text='CHT: Plot density' type='combobox'><meta>&lt;i&gt;None&lt;/i&gt;&lt;i&gt;Density 2D&lt;/i&gt;</meta><data>1</data></Parameter>
  <Parameter id='idxBorder' text='CHT: Cluster Borders' type='combobox'><meta>&lt;i&gt;None&lt;/i&gt;&lt;i&gt;Limits&lt;/i&gt;&lt;i&gt;Ellipse&lt;/i&gt;</meta><data>2</data></Parameter>
  <Parameter id='idOutput' text='OUT: Display output as:' type='combobox'><meta>&lt;i&gt;None&lt;/i&gt;&lt;i&gt;Chart Window&lt;/i&gt;&lt;i&gt;Static HTML Document&lt;/i&gt;&lt;i&gt;Dynamic HTML Document&lt;/i&gt;</meta><data>0</data></Parameter>
  <Parameter id='idxRun' text='OUT: Run Only (do not show plots)' type='bool'>1</Parameter>
  <Parameter id='centers' text='OUT: Include distance from center?' type='bool'>0</Parameter>
  <Parameter id='idxSave' text='OUT: Save Outputs and Model' type='bool'>0</Parameter>
  <Parameter id='idxDir' text='OUT: Output Directory' type='onedir'><data>:/</data></Parameter>
  <Parameter id='VarNames' text='Variable List' type='allcolumns'>1</Parameter>
  <Parameter id='RowLabels' text='Optional Row Labels' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='idxColor1' text='Default Point Color' type='color'>#00bfff</Parameter>
</Parameters>
<Script>

</Script>
</R>
<aggregate idx='2108' x='1032' y='624' inRAMAlgo='1' omitSuffix='1'>
 <OneAggregate counts='1'>
  <GroupBy>
   <v name='X.Cluster.cluster'/>
  </GroupBy>
  <OutputVars>
   <v name='pY_dmin' imin='1'/>
   <v name='pY_dmax' imax='1'/>
   <v name='Q1' mean='1'/>
   <v name='Median' mean='1'/>
   <v name='Q3' mean='1'/>
   <v name='IQR' mean='1'/>
   <v name='lower_fence' imin='1'/>
   <v name='upper_fence' imax='1'/>
  </OutputVars>
 </OneAggregate>
</aggregate>
<R idx='2109' x='816' y='624' id='My_rTemplate'
  orignalId='rTemplate'
 deprecated='1'
  longName='this operator simply &quot;pass by&quot; the rows without doing anything'
  image=''
  author='Frank Vanden Berghen'
  revision='0.01'
  tags='370_R'
  pdfDestination='9_2_2_r_integration_inside_anat'>
<Description>
&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;MS Shell Dlg 2&apos;; font-size:14px; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;This operator simply &amp;quot;pass by&amp;quot; the rows from the input pin to the output pin without doing any treatment.&lt;br /&gt;This operator is simply a &amp;quot;Basic Template&amp;quot; that you can can &amp;quot;tweak&amp;quot; to create your own, complex operator.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;
</Description>
<Parameters>
  <Parameter id='mytable' text='whole table' type='allcolumns'></Parameter>
  <Parameter id='Predictors' text='a short description' type='manycolumns'><meta>0</meta><data><c>pY_dmin</c><c>pY_dmax</c><c>Q1</c><c>Median</c><c>Q3</c></data></Parameter>
  <Parameter id='idxSegNum' text='a short description' type='double'>30</Parameter>
  <Parameter id='idxMethod' text='a short description' type='combobox'><meta>&lt;i&gt;Hartigan-Wong&lt;/i&gt;&lt;i&gt;Lloyd&lt;/i&gt;&lt;i&gt;Forgy&lt;/i&gt;&lt;i&gt;MacQueen&lt;/i&gt;</meta><data>0</data></Parameter>
  <Parameter id='idxStart' text='a short description' type='double'>15</Parameter>
  <Parameter id='idxMax' text='a short description' type='double'>500</Parameter>
  <Parameter id='idxSeed' text='a short description' type='double'>0</Parameter>
</Parameters>
<Script>
packages &lt;- c("stats","cluster","reshape2","scales", "mice")
# Install packages not yet installed
installed_packages &lt;- packages %in% rownames(installed.packages())
if (any(installed_packages == FALSE)) {
    print("The following packages have not been found in the R installation")
    print(packages[!installed_packages])
    print("With older versions of R, this may destroy some functionalities. If R fails to work, go to UPDATE TIMI, and select the INCREMENTAL UPDATE of R to restore the damage libraries")
    install.packages(packages[!installed_packages],repos=RemoteRepository, dependencies =TRUE)
}
invisible(lapply(packages, library, character.only = TRUE))
col_means &lt;- colMeans(Predictors, na.rm = TRUE)
Predictors[] &lt;- lapply(seq_along(Predictors), function(j) {
  x &lt;- Predictors[[j]]
  x[is.infinite(x) | is.nan(x) | is.na(x)] &lt;- col_means[j]
  x
})
X &lt;-apply (as.matrix (Predictors), 2, as.numeric)
X.Cluster &lt;- kmeans(X, idxSegNum, iter.max = idxMax, nstart = idxStart, algorithm =switch(idxMethod+1,"Hartigan-Wong", "Lloyd", "Forgy","MacQueen"))
Y &lt;- data.frame(X.Cluster$cluster)
R_Output &lt;- cbind(mytable,Y)
</Script>
</R>
