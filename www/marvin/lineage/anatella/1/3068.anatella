    <OutputVar name='Median' update='1'>isNull(Median)?(Q1+Q3)/2:Median</OutputVar>
    <OutputVar name='lower_fence'>Q1 - (1.5 * IQR)</OutputVar>
    <OutputVar name='upper_fence'>Q1 + (1.5 * IQR)</OutputVar>
  </OutputVars>
</Calculator>
