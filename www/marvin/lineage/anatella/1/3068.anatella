<Generic idx='13' v='3.17' x='1560' y='-708' id='setGlobalParameters'
  longName='set the value of some global Parameters'
  le='1729847485040'
  abortOnMissingColumn='0'
  shape='3'
  keywords='set global parameter'
  image='/setGlobalParameters.svg'
  author='Frank Vanden Berghen'
  revision='0.11'
  tags='800_Other'>
<Description>
Set the value of some Global Parameters.&lt;br/&gt;
&lt;br/&gt;
The input table has many columns and one row (if there are more rows, they are ignored).&lt;br/&gt;
Each input column defines the value of a different Global Parameter:&lt;ol&gt;
&lt;li&gt;The name of the Global Parameter to set is the name of the column.&lt;/li&gt;
&lt;li&gt;The new value of the Global Parameter to set is the content of the column (on the first row).&lt;/li&gt;&lt;/ol&gt;
</Description>
<Parameters>
  <Parameter id='idSkip' text='Skip the first X columns. X=?' type='double'>1</Parameter>
  <Parameter id='setOnlyIfEmpty' text='Only set value if Global Parameter is empty' type='bool'>0</Parameter>
</Parameters>
<Script>
function init(){return 0;}

function setGP2(name,v)
{
    var transient=false;
    if (name[0]=='*') { name=name.substr(1); transient=true; }
    if ((name[0]>='0')&amp;&amp;(name[0]&lt;='9')) throw "ERROR:Global Parameter's Names cannot start with a digit(here:'"+name+"').";
    if (name.indexOf(".")>=0) throw "ERROR:Global Parameter's Names cannot contain a dot.";
    if (!(name in this)) { newGlobalVar(name,"",transient); }
    else
    {
        if (setOnlyIfEmpty) 
        { 
            var getValue=new Function("return "+name+";");
            if (getValue()!="") return;
        }
    }
    v=v.replace(new RegExp("\\\\", 'g'), "\\\\");
    v=v.replace(new RegExp("\"", 'g'), "\\\"");
    v=v.replace(new RegExp("\n", 'g'), "");
    v=v.replace(new RegExp("\r", 'g'), "");
    t=name+"=\""+v+"\";"
    var assign=new Function(t);
    assign();
}

function run()
{    
    var r=getNextRow();
    if (r.isNull) return 1;
    
    var i,n=r.nColumn;
    for(i=idSkip;i&lt;n;i++)
        setGP2(rowGetColumnName(r,i),""+r.col(i));

    return 1;
}
</Script>
</Generic>
