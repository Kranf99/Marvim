<Generic idx='1861' x='888' y='-288' id='get_meta-data'
  longName='Get meta-data'
  le='1760543422492'
  abortOnMissingColumn='0'
  keywords='meta data extract get'
  image='/getMetaData.svg'
  author='Frank Vanden Berghen'
  revision='0.05'
  tags='150_Standard'
  pdfDestination='5_5_14_get_meta_data'>
<Description>
Get meta-data: column name &amp; type + sort meta-data.&lt;br/&gt;&lt;br/&gt;
Do not enable the option &quot;pump all rows from input&quot; unless you know what you are doing
</Description>
<Parameters>
  <Parameter id='idMeta2' text='meta-data type column contains:' type='combobox'><meta>&lt;i&gt;U,K,F&lt;/i&gt;&lt;i&gt;STRING,KEY,FLOAT&lt;/i&gt;</meta><data>0</data></Parameter>
  <Parameter id='readAll' text='pump all rows from input' type='bool'>0</Parameter>
</Parameters>
<Script>
var rIn,rOut,i,ak,at;
function init()
{
    rIn=getCurrentRow();
    if (rIn.isNull) return 0;
    rIn=rowDeepCopy(rIn);
    setOutputRowSize(0,5);
    i=0;
    rOut=new Row(5);
    rowSetColumnName(rOut,0,"Before");
    rowSetColumnName(rOut,1,"After");
    rowSetColumnName(rOut,2,"Type");
    rowSetColumnName(rOut,3,"SortPriority");
    rowSetColumnName(rOut,4,"SortType");
    
    var j=rIn.nColumn,k=0;
    ak=new Array(j); at=new Array(j);
    while(j--) { ak[j]=null; at[j]=null; }
    for(;;)
    {
        var j=rowGetSortColumnIdx(rIn,k);
        if (j&lt;0) break;
        ak[j]=k;
        at[j]=rowGetSortType(rIn,k);
        k++;
    }
    return 0;
}

function run()
{
    if (rIn.isNull) return 1;
    if (i==rIn.nColumn) 
    {
        if (readAll)
        {
            var r;
            for(;;)
            {
                getNextRow();getNextRow();getNextRow();getNextRow();
                getNextRow();getNextRow();getNextRow();getNextRow();
                getNextRow();getNextRow();getNextRow();getNextRow();
                r=getNextRow();
                if (r.isNull||userAskedAbort()) return 1;
            }
        }
        return 1;
    }
    var cn=rowGetColumnName(rIn,i);
    rOut.setColumn(0,cn);
    rOut.setColumn(1,cn);
    if (!idMeta2) rOut.setColumn(2,rowGetMetaType(rIn,i));
    else
    {
        var mt=rowGetMetaType(rIn,i);
        if (mt=="U") mt="STRING";
        else if (mt=="K") mt="KEY";
        else if (mt=="F") mt="FLOAT";
        rOut.setColumn(2,mt);
    }
    rOut.setColumn(3,ak[i]);
    rOut.setColumn(4,at[i]);
    i++;
    rOut.write(); 
    writeEOL();
    return 0;
}
</Script>
</Generic>
