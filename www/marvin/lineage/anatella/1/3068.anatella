<Generic keyHD='178249093450632207' idx='1876' x='516' y='-456' id='create1Var'
 deprecated='1'
  longName='create one new var'
  image='create1var.png'
  author='Frank Vanden Berghen - Didier Baclin'
  revision='0.21'
  tags='150_Standard'>
<Description>
This action is deprecated: use the &quot;Calculator&quot; action instead.&lt;br/&gt;&lt;br/&gt;
Create one new derivate column using mathematical operations on columns.
</Description>
<Parameters>
  <Parameter id='colName' text='name of the new column to create' type='string'>NewVar</Parameter>
  <Parameter id='myMetaType' text='type of the new column' type='combobox'><meta>&lt;i&gt;Meta-Type of New Column is &quot;string&quot; or &quot;unknown&quot;&lt;/i&gt;&lt;i&gt;Meta-Type of New Column is &quot;Number&quot;&lt;/i&gt;</meta><data>0</data></Parameter>
  <Parameter id='myoperation' text='mathematical expression defining the new column' type='string'>String.fromCharCode(97+x)</Parameter>
  <Parameter id='varAreNumbers' text='All variables (X,Y,Z,A,B,C,D,...) are numbers?' type='bool'>0</Parameter>
  <Parameter id='myVar1' text='X = which column ?' type='onecolumn'><meta>0</meta><data>Key</data></Parameter>
  <Parameter id='myVar2' text='Y = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='myVar3' text='Z = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='myVar4' text='A = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='myVar5' text='B = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='myVar6' text='C = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='myVar7' text='D = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='myVar8' text='E = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='myVar9' text='F = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='myVar10' text='G = which column ?' type='onecolumn'><meta>0</meta><data></data></Parameter>
</Parameters>
<Script>
var myrow,nVars,myfunc,n;

function parallelRun(v) { return true; }

function init()
{
   var r=getCurrentRow();
   if (r.isNull) return 1;
   setOutputRowSize(0,r.nColumn+1);
   myrow=new Row(1);
   rowSetColumnName(myrow,0,colName);
   if (myMetaType==1) rowSetMetaType(myrow,0,'F');
          if (myVar10>=0) { nVars=10;myfunc=new Function( "x","y","z","a","b","c","d","e","f","g", "return "+myoperation);  }
   else if (myVar9>=0)  { nVars=9;  myfunc=new Function( "x","y","z","a","b","c","d","e","f", "return "+myoperation);  }
   else if (myVar8>=0)  { nVars=8;  myfunc=new Function( "x","y","z","a","b","c","d","e", "return "+myoperation);  }
   else if (myVar7>=0)  { nVars=7;  myfunc=new Function( "x","y","z","a","b","c","d", "return "+myoperation);  }
   else if (myVar6>=0)  { nVars=6;  myfunc=new Function( "x","y","z","a","b","c", "return "+myoperation);  }
   else if (myVar5>=0)  { nVars=5;  myfunc=new Function( "x","y","z","a","b", "return "+myoperation);  }
   else if (myVar4>=0)  { nVars=4;  myfunc=new Function( "x","y","z","a", "return "+myoperation);  }
   else if (myVar3>=0)  { nVars=3;  myfunc=new Function( "x","y","z", "return "+myoperation);  }
   else if (myVar2>=0)  { nVars=2;  myfunc=new Function( "x","y", "return "+myoperation);  }
   else if (myVar1>=0)  { nVars=1;  myfunc=new Function( "x", "return "+myoperation);  }
   else                            { nVars=0;  myfunc=new Function( "return "+myoperation);  }
   n=0;
   return 0;
}

function run()
{
   var r=getNextRow();
   if (r.isNull) return 1;
   
   var res;
   if (varAreNumbers)
   {
       switch(nVars)
       {
       case 0: res=myfunc(); break;
       case 1: res=myfunc(Number(r.col(myVar1))); break;
       case 2: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2))); break;
       case 3: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2)),Number(r.col(myVar3))); break;
       case 4: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2)),Number(r.col(myVar3)),Number(r.col(myVar4))); break;
       case 5: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2)),Number(r.col(myVar3)),Number(r.col(myVar4)),Number(r.col(myVar5))); break;
       case 6: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2)),Number(r.col(myVar3)),Number(r.col(myVar4)),Number(r.col(myVar5)),Number(r.col(myVar6))); break;
       case 7: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2)),Number(r.col(myVar3)),Number(r.col(myVar4)),Number(r.col(myVar5)),Number(r.col(myVar6)),Number(r.col(myVar7))); break;
       case 8: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2)),Number(r.col(myVar3)),Number(r.col(myVar4)),Number(r.col(myVar5)),Number(r.col(myVar6)),Number(r.col(myVar7)),Number(r.col(myVar8))); break;
       case 9: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2)),Number(r.col(myVar3)),Number(r.col(myVar4)),Number(r.col(myVar5)),Number(r.col(myVar6)),Number(r.col(myVar7)),Number(r.col(myVar8)),Number(r.col(myVar9))); break;
       case 10: res=myfunc(Number(r.col(myVar1)),Number(r.col(myVar2)),Number(r.col(myVar3)),Number(r.col(myVar4)),Number(r.col(myVar5)),Number(r.col(myVar6)),Number(r.col(myVar7)),Number(r.col(myVar8)),Number(r.col(myVar9)),Number(r.col(myVar10))); break;
       }
   } else
   {
       switch(nVars)
       {
       case 0: res=myfunc(); break;
       case 1: res=myfunc(r.col(myVar1)); break;
       case 2: res=myfunc(r.col(myVar1),r.col(myVar2)); break;
       case 3: res=myfunc(r.col(myVar1),r.col(myVar2),r.col(myVar3)); break;
       case 4: res=myfunc(r.col(myVar1),r.col(myVar2),r.col(myVar3),r.col(myVar4)); break;
       case 5: res=myfunc(r.col(myVar1),r.col(myVar2),r.col(myVar3),r.col(myVar4),r.col(myVar5)); break;
       case 6: res=myfunc(r.col(myVar1),r.col(myVar2),r.col(myVar3),r.col(myVar4),r.col(myVar5),r.col(myVar6)); break;
       case 7: res=myfunc(r.col(myVar1),r.col(myVar2),r.col(myVar3),r.col(myVar4),r.col(myVar5),r.col(myVar6),r.col(myVar7)); break;
       case 8: res=myfunc(r.col(myVar1),r.col(myVar2),r.col(myVar3),r.col(myVar4),r.col(myVar5),r.col(myVar6),r.col(myVar7),r.col(myVar8)); break;
       case 9: res=myfunc(r.col(myVar1),r.col(myVar2),r.col(myVar3),r.col(myVar4),r.col(myVar5),r.col(myVar6),r.col(myVar7),r.col(myVar8),r.col(myVar9)); break;
       case 10: res=myfunc(r.col(myVar1),r.col(myVar2),r.col(myVar3),r.col(myVar4),r.col(myVar5),r.col(myVar6),r.col(myVar7),r.col(myVar8),r.col(myVar9),r.col(myVar10)); break;
       }
   }
   myrow.setColumn(0,res);
   myrow.write(0);
   r.write(0);
   writeEOL();
   n++;
   return 0;
}
</Script>
