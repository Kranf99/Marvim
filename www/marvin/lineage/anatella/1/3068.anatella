<Generic idx='1959' x='-2328' y='1980' id='concatString'
  longName='concatenate strings'
  le='1758730637982'
  abortOnMissingColumn='0'
  keywords='concatenate string aggregate'
  image='/concatV.svg'
  author='Frank Vanden Berghen'
  revision='0.06'
  tags='500_Formatter'
  pdfDestination='5_19_1_concat'>
<Description>
This operator concatenate strings over several rows.
</Description>
<Parameters>
  <Parameter id='idKey' text='key column (partition column)' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='idConcat' text='columns to concatenate' type='manycolumns'><meta>0</meta><data><c>NewVar</c></data></Parameter>
  <Parameter id='sepChar' text='separation string' type='string'>,</Parameter>
  <Parameter id='sPrefix' text='prefix string' type='string'></Parameter>
  <Parameter id='sSuffix' text='suffix string' type='string'></Parameter>
  <Parameter id='idSkip' text='Skip (do not concat) empty cells' type='bool'>0</Parameter>
  <Parameter id='idCheck' text='Check that the input table is properly sorted
(do not change unless you know what you are doing)' type='bool'>1</Parameter>
</Parameters>
<Script>
var s,prevKey,mr,r,n;
function parallelRun(v) { return v==idKey; }

function init()
{
    r=getCurrentRow();
    if (r.isNull) return 1;
    n=idConcat.length;
    mr=new Row(1+n);
    if (idKey>=0)
    {
        if (idCheck&amp;&amp;(rowGetSortColumnIdx(r,0)!=idKey))
            throw "The input table must be sorted on the partition column '"+rowGetColumnName(r,idKey)+"'.";
        prevKey=r.col(idKey);
        rowSetColumnName(mr,0,rowGetColumnName(r,idKey));
    } else 
    {    
        prevKey="";
        rowSetColumnName(mr,0,"No_partition");
    }
    var i=n;
    while(i--) rowSetColumnName(mr,1+i,rowGetColumnName(r,idConcat[i]));
    setOutputRowSize(0,1+n);
    s=new Array(n);
    getNextRow();
    return 0;
}

function outputARow()
{
    var i=n,t;
    while(i--) 
    {
        t=s[i].join(sepChar);
        if ((idSkip)&amp;&amp;(t.length>0)&amp;&amp;(t[0]==sepChar)) 
            t=t.substring(1);
        mr.setColumn(1+i,t);
    }
    mr.write(); 
    writeEOL();
}

function run()
{
//    if (r.isNull) return 1;
    mr.setColumn(0,prevKey);
    var i=n,t;
    if (idSkip)
    {
        while(i--) 
        {
            t=String(r.col(idConcat[i]))
            if (t.length>0) s[i]=[sPrefix+t+sSuffix];
            else s[i]=[];
        }
    } else
    {
        while(i--) s[i]=[sPrefix+r.col(idConcat[i])+sSuffix];
    }
    for(;;)
    {
         r=getNextRow();
         if (r.isNull)
         {
            outputARow();
            return 1;
         }
         if (userAskedAbort()) return 1;
         if (idKey>=0)
         {
             curKey=r.col(idKey);
             if (curKey!=prevKey) break;
         }
        i=n;
        if (idSkip)
        {
            while(i--) 
            {
                t=String(r.col(idConcat[i]))
                if (t.length>0) s[i].push(sPrefix+t+sSuffix);
            }
        } else
        {
            while(i--) s[i].push(sPrefix+r.col(idConcat[i])+sSuffix);
        }
    }
    outputARow();
    prevKey=curKey; 
    return 0;
}
</Script>
</Generic>
