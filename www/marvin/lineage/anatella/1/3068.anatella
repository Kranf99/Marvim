<Generic idx='1879' x='840' y='-516' id='aggregateInOneCell'
  longName='aggregate in one cell'
  le='1435426090426'
  keywords='aggregate one cell'
  image='/aggregateIn1Cell.png'
  author='Frank Vanden Berghen'
  revision='0.02'
  tags='500_Formatter'>
<Description>
This operator aggregates many rows and columns inside one cell.&lt;br&gt;
The columns are separated with tabs.&lt;br&gt;
The rows are separated with carriage returns.
</Description>
<Parameters>
  <Parameter id='idAgg' text='columns to aggregate in one cell' type='manycolumns'><meta>0</meta><data><c>var</c><c>op</c><c>value</c><c>logic</c></data></Parameter>
  <Parameter id='idMax' text='compute maximum of:' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='addNames' text='include column names in aggregation' type='bool'>0</Parameter>
</Parameters>
<Script>
function fullTableRequiredToComputeMetas(idxPinIn) { return false; }

function init()
{
    if (idAgg.length==0) throw "nothing to aggregate?";
    if (idMax>=0)  setOutputRowSize(0,2);
    else setOutputRowSize(0,1);
    return 0;
}

function run()
{
    var s="",isFirstRun=true,myMax,d;
    for(;;)
    {
        if (userAskedAbort()) break;
        var r=getNextRow();
        if (r.isNull) 
        {
            if (idMax>=0) 
            {
                var mr=new Row(2);
                rowSetColumnName(mr,0,"AggregatedCells");
                rowSetColumnName(mr,1,"MaxValue");
                rowSetMetaType(mr,1,'F');
                mr.setColumn(0,s);
                mr.setColumn(1,myMax);
                mr.write();
            } else
            {
                var mr=new Row(1);
                rowSetColumnName(mr,0,"AggregatedCells");
                mr.setColumn(0,s);
                mr.write();
            }
            writeEOL();
            return 1;
        }
        if (isFirstRun) 
        {
            isFirstRun=false;
            if (idMax>=0) myMax=Number(r.col(idMax));
            if (addNames)
            {
                s=rowGetColumnName(r,idAgg[0]);
                for(i=1;i&lt;idAgg.length;i++) s+="\t"+rowGetColumnName(r,idAgg[i]);
                s+="\n";
            }
        } else
        {
            s+="\n";
            if (idMax>=0) 
            {
                d=Number(r.col(idMax));
                if (d>myMax) myMax=d;
            }
        }
        s+=r.col(idAgg[0]);
        for(i=1;i&lt;idAgg.length;i++) s+="\t"+r.col(idAgg[i]);
    }
    return 1;
}
</Script>
</Generic>
