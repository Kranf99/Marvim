<Generic idx='1829' x='1692' y='1416' id='doWebServiceBridge'
  longName='do the Web Service Bridge'
  nPinIn='0'
  le='1754928885398'
  keywords='webservice service php bridge browser microservice internet cloud'
  image='/serverPHP.svg'
  author='Frank Vanden Berghen'
  revision='0.02'
  tags='600_System Tools'
  pdfDestination='9_2_1_javascript_integration_in'>
<Description>
If the &quot;Anatella Engine Install Dir&quot; parameter is empty, then we&apos;ll use the current location of the Anatella engine (i.e. usually, it&apos;s &quot;c:/soft/TIMi&quot;).
</Description>
<Parameters>
  <Parameter id='idVars' text='List of Input Variables for the Webservice (comma separated)' type='string'>fileName,pX,pY,maxRow</Parameter>
  <Parameter id='idREs' text='Regular Expression to validate Input Variables (comma separated)' type='string'>[a-zA-Z0-9 ]+,[a-zA-Z0-9 ]+,[a-zA-Z0-9 ]+,[0-9]+</Parameter>
  <Parameter id='idMaxSize' text='Input Variables Max Size (comma separated)' type='string'>200,200,200,200</Parameter>
  <Parameter id='idMinSize' text='Input Variables Min Size (comma separated)' type='string'>1,1,0,0</Parameter>
  <Parameter id='idGraph' text='Anatella Graph to run inside the webservice' type='onefileopen'><meta>*.anatella</meta><data>:/GetVarDetails.anatella</data></Parameter>
  <Parameter id='idPhpFile' text='Final Web Service Brige (Php-&gt;Anatella)' type='onefilesave'><meta>*.php</meta><data>:/web_GetVarDetails.php</data></Parameter>
  <Parameter id='idTemp' text='Temp Directory (optional)' type='onedir'><data>C:/soft/uwamp/www/TimeSeries/tmp</data></Parameter>
  <Parameter id='idADir' text='Anatella Engine Install Dir (optional)' type='onedir'><data></data></Parameter>
  <Parameter id='idReset' text='If an Input Variable is missing:' type='combobox'><meta>&lt;i&gt;Use default value&lt;/i&gt;&lt;i&gt;reset it to empty&lt;/i&gt;&lt;i&gt;reset it to zero&lt;/i&gt;</meta><data>1</data></Parameter>
  <Parameter id='idDebug' text='Development Mode (display errors)?' type='bool'>0</Parameter>
</Parameters>
<Script>
function init(){ getCurrentRow(); return 0; }

function makeRelative(s)
{
    if (s.indexOf(currentDir)==0)
        return s.substring(currentDir.length,99999);
    return s;
}

function run()
{
   var myVars=idVars.split(","),
        myREs=idREs.split(","),
        myMaxSize=idMaxSize.split(","),
        myMinSize=idMinSize.split(",");
   if (myVars.length!=myREs.length) throw "The number of input variables and the number of Regular Expression for validation do not match";
   if (myVars.length!=myMaxSize.length) throw "The number of input variables and the number of Upper boundaries on variables's sizes do not match";
   if (myVars.length!=myMinSize.length) throw "The number of input variables and the number of Lower boundaries on variables's sizes do not match";

   if (idGraph=="") throw "Please give the filepath to the Anatella graph to execute inside the Webservice";
   if (idPhpFile=="") throw "Please give the filepath to the PHP script that calls your Anatella graph as a Webservice";

   print("We have "+myVars.length+" input parameters inside the PHP script/WebService '"+idPhpFile+"' that runs the Anatella graph '"+idGraph+"'");

   {
       // check that each variable only contains "easy" chars
       var simplevarsRE=/^[_a-zA-Z][_a-zA-Z0-9]*$/
       for(i=0;i&lt;myVars.length;i++)
            if (!simplevarsRE.test(myVars[i]))
                throw "The variable '"+myVars[i]+"' contains invalid chars.";
   }
   var s="&lt;?php\n",v;

   // check that each parameter is given in PHP
   // also check size
   for(i=0;i&lt;myVars.length;i++)
   {
        mv=myVars[i];
        v="$_REQUEST['"+mv+"']";
        if (myMinSize[i]>0)
        {
            s+="if (!array_key_exists('"+mv+"', $_REQUEST)){\n"+
                 "   http_response_code(400);\n"+
                 "   echo \"Parameter '"+mv+"' is missing\";\n"+
                 "   die;\n"+
                 "}\n"+
                 "$len=strlen("+v+");\n"+
                 "if ($len&lt;"+myMinSize[i]+") {\n"+
                 "   http_response_code(400);\n"+
                 "   echo \"Parameter '"+mv+"' is too short\";\n"+
                 "   die;\n"+
                 "}\n"+
                 "if ($len>="+myMaxSize[i]+") {\n"+
                 "   http_response_code(400);\n"+
                 "   echo \"Parameter '"+mv+"' is too long\";\n"+
                 "   die;\n"+
                 "}\n";
        } else
        {
            s+="if (array_key_exists('"+mv+"', $_REQUEST)){\n"+
                 "  $len=strlen("+v+");\n"+
                 "  if ($len>="+myMaxSize[i]+") {\n"+
                 "    http_response_code(400);\n"+
                 "    echo \"Parameter '"+mv+"' is too long\";\n"+
                 "    die;\n"+
                 "  }\n"+
                 "}\n";
        }
   }

   // check regular expresssions
   for(i=0;i&lt;myVars.length;i++)
   {
        if (!myREs[i].length) continue;
        mv=myVars[i];
        v="$_REQUEST['"+mv+"']";
        if (myMinSize[i]>0)
        {
            s+="if (!preg_match('/^"+myREs[i]+"$/',"+v+")) {\n";
        } else
        {
            s+="if ((array_key_exists('"+mv+"', $_REQUEST))&amp;&amp;\n"+
                 "    (!preg_match('/^"+myREs[i]+"$/',"+v+"))) {\n";
        }
        s+="   http_response_code(400);\n"+
             "   echo \"Regular Expression Test failed for parameter '"+mv+"'\";\n"+
 	  "   die;\n"+
             "}\n";
     }

   s+="$toExec='';\n";
   for(i=0;i&lt;myVars.length;i++)
   {
        v=myVars[i];
        if (myMinSize[i]==0)
            s+="if (array_key_exists('"+v+"', $_REQUEST)) ";
        s+="$toExec.=' '.escapeshellarg('-D"+v+"='.$_REQUEST['"+v+"']);\n";
        if ((myMinSize[i]==0)&amp;&amp;idReset)
        {
            s+="else $toExec.=' \"-D"+v+"=";
            if (idReset==1) s+="\"';\n"; else s+="0\"';\n"; 
        }
   }

   if (idTemp=="")
   {
        idTemp=currentDir+"tmp";
        mkDir(idTemp);
   }
   if (idADir=="") idADir=anatellaDir;
   else idADir+="/bin";

   s+="\ndate_default_timezone_set(\"UTC\");\n"+
      "$id=uniqid(\"ws_\".date(\"Ymd_\"));\n"+
      "exec('\""+idADir+"/AnatellaConsole.exe\" \""+makeRelative(idGraph)+"\" '.$toExec.' -DfileOut='.$id.'.json";
    if (!idDebug) s+="');\n";
    else
    {
        s+=" 2>&amp;1',$fake,$result_code);\n"+
            "if ($result_code>1) {\n"+
            "   http_response_code(400);\n"+
            "   echo '&lt;html>&lt;body>&lt;PRE>Error running Anatella (errorLevel='.$result_code.\")&lt;br>\".implode(\"&lt;br>\",$fake);\n"+
            "   die;\n"+
            "}\n";
    }
    s+="header('Content-type: application/json');\n"+
      "@readfile(\""+makeRelative(idTemp)+"/$id.json\");\n"+
      "?>";

   fileSave(idPhpFile,s,3);
   return 1;
}
</Script>
</Generic>
