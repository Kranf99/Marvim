<TEXTANNOTATIONS>
  <Annotation x='-1656' y='2304' size='14' anchor='363'>MPDS_RESPONSABLE_ATENCION</Annotation>
  <Annotation x='-4584' y='984' size='14'>SELECT E.ID_EXPEDIENTE,
       E.NUMERO,       (SELECT A.NOMBRE FROM AREA A WHERE A.ID_AREA = PPT.ID_AREA_DESTINATARIO) AS AREA
FROM EXPEDIENTE E
         LEFT JOIN TRAZA T ON E.ID_EXPEDIENTE = T.ID_EXPEDIENTE
         LEFT JOIN PERSONA_POR_TRAZA PPT ON T.ID_TRAZA = PPT.TRAZA
WHERE T.ACTUAL = 1
  AND EXISTS(
        SELECT SSD.FECHA_CREACION
        FROM EXPEDIENTE E2
                 LEFT JOIN SGDTV_SOLICITUD_DESPACHO SSD ON E2.ID_EXPEDIENTE = SSD.ID_EXPEDIENTE
        WHERE SSD.ATIENDE_TRAMITE = 1
          AND E2.ID_EXPEDIENTE = E.ID_EXPEDIENTE
    );</Annotation>
  <Annotation x='-3576' y='2496' size='14' bold='1' color='#ff0000' anchor='588'>AREA</Annotation>
  <Annotation x='-4860' y='2340' size='14' bold='1' color='#0000ff' anchor='587'>EXPEDIENTE</Annotation>
  <Annotation x='-4812' y='2448' size='14' bold='1' color='#228b22' anchor='589'>TRAZA</Annotation>
  <Annotation x='-4956' y='2568' size='14' bold='1' color='#228b22' anchor='593'>PERSONA_POR_TRAZA</Annotation>
  <Annotation x='-5028' y='2736' size='14' bold='1' color='#228b22' anchor='600'>SGDTV_SOLICITUD_DESPACHO</Annotation>
  <Annotation x='-4464' y='1548' size='14' bold='1' color='#228b22'>SELECT E.ID_EXPEDIENTE,
       E.NUMERO,       PPT.PERSONA,
       (SELECT A.NOMBRES || &apos; &apos; || A.APELLIDOS  FROM PERSONA A WHERE A.ID_PERSONA = PPT.PERSONA) AS PERSONA
FROM EXPEDIENTE E
         LEFT JOIN TRAZA T ON E.ID_EXPEDIENTE = T.ID_EXPEDIENTE
         LEFT JOIN PERSONA_POR_TRAZA PPT ON T.ID_TRAZA = PPT.TRAZA
WHERE T.ACTUAL = 1
  AND EXISTS(
        SELECT SSD.FECHA_CREACION
        FROM EXPEDIENTE E2
                 LEFT JOIN SGDTV_SOLICITUD_DESPACHO SSD ON E2.ID_EXPEDIENTE = SSD.ID_EXPEDIENTE
        WHERE SSD.ATIENDE_TRAMITE = 1
          AND E2.ID_EXPEDIENTE = E.ID_EXPEDIENTE
    );</Annotation>
