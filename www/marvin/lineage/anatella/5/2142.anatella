TRUNC(F.FE_REGI) FE_REGI
TO_CHAR(E.FE_CREA_AUDI, &apos;HH24&apos;) HORA
NVL(D.IM_DOC_ADJ, 0) IM_RECIBO
LDPK_ETL_LPROC_DNI.LDFU_FE_ENVIO
