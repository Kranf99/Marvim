<TEXTANNOTATIONS>
  <Annotation x='-2712' y='-96' size='6' anchor='10'>IDOIMPRESION.IMTD_LOTE_IMPRESION I</Annotation>
  <Annotation x='-2688' y='84' size='6' anchor='11'>IDOIMPRESION.IMTC_LOTE_IMPRESION_DNIE C</Annotation>
  <Annotation x='-2664' y='180' size='6' anchor='12'>IDOCAPTURA.PRTV_FICHA_REGISTRAL F</Annotation>
  <Annotation x='-2712' y='360' size='6' anchor='13'>IDOCAPTURA.PRTX_DOC_ADJUNTO_TRAMITE D</Annotation>
  <Annotation x='-1092' y='384' size='6' anchor='14'>IDOTABMAESTRA.GETM_ANI U</Annotation>
  <Annotation x='-1788' y='420' size='6' anchor='16'>IDOIMPRESION.IMTV_CONTROL_PROCESO_DNIE P</Annotation>
  <Annotation x='-2376' y='-36' size='6' anchor='17'>SE FILTRA 
ES_LOTE_IMPR = &quot;1&quot;
&amp;&amp; (IN_IMPRESION = &quot;1&quot; || IN_IMPRESION =&quot;2&quot;)
&amp;&amp; IN_PREPARACION_DATOS = &quot;1&quot;
&amp;&amp; ceil(FE_CREA_AUDI) &lt;= P_DFE_DATA</Annotation>
  <Annotation x='-2352' y='240' size='6' anchor='18'>SE FILTRA CON
ES_FICHA_REG = &quot;1&quot;
CO_TIPO_CATURA IN 1,2,4
IN_DNIE SEA igual a 1</Annotation>
  <Annotation x='-2196' y='-192' size='6' anchor='23'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG
Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='-2220' y='228' size='6' anchor='25'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-2376' y='408' size='6' anchor='19'>sE FILTRA CON CO_DOC_ADJ = &quot;165&quot;</Annotation>
  <Annotation x='-2220' y='396' size='6' anchor='26'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-1452' y='480' size='6' anchor='20'>SE FILTRA
CO_PROCESO = &quot;A&quot; &amp;&amp;
ceil(FE_CREA_AUDI) &lt;= P_DFE_DATA</Annotation>
  <Annotation x='-2388' y='-144' size='6' anchor='28'>sE FILTRA ES_DNI_LOTE = 1</Annotation>
  <Annotation x='-1272' y='480' size='6' anchor='27'>Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='-864' y='192' size='6'>SE REALIZA LEFT JOIN ENTRE LA FUENTE U Y F
POR EL CAMPO F.NU_DNI_TITULAR = U.NU_DNI</Annotation>
