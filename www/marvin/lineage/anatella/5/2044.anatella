<Generic idx='1277' x='1944' y='252' id='printLog'
  longName='print a table into the log'
  le='1677715736540'
  abortOnMissingColumn='0'
  keywords='print log table code display debug'
  image='/printLog.svg'
  author='Frank Vanden Berghen'
  revision='0.03'
  tags='600_System Tools'
  pdfDestination='5_25_2_template'>
<Description>

</Description>
<Parameters>
  <Parameter id='idSize' text='column size' type='double'>40</Parameter>
  <Parameter id='idText' text='text header' type='string'>No. Registros insertados</Parameter>
  <Parameter id='idPH' text='Print Header Row?' type='bool'>1</Parameter>
</Parameters>
<Script>
var blank="",a=[];
function parallelRun(v) { return false; }
function init(){return 0;}

function justify(s,i)
{
    s=String(s);
    if (s.length&lt;idSize) 
    {
        if (a[i]=='U') 
        {
            s=s+blank;
            return s.substr(0,idSize);
        }
        s=blank+s;
        return s.substr(s.length-idSize,idSize);
    }
    return s.substr(0,idSize-2)+"..";
}

function run()
{
    if(idText.length>0) print(idText);
    var r=getNextRow();
    if (r.isNull) return 1;
    var i=idSize,n=r.nColumn,s="";
    while(i--) blank+=" ";
    i=n;
    while(i--) a=rowGetMetaType(r,i);
    if (idPH)
    {
        s=justify(rowGetColumnName(r,0).toUpperCase(),0);
        for(i=1;i&lt;n;i++) 
            s+="|"+justify(rowGetColumnName(r,i).toUpperCase(),i);
        {
            var b2=blank.replace(/./g,"-"),s2=b2;
            for(i=1;i&lt;n;i++) s2+="+"+b2;
            s=s+"\n"+s2;
        }
        print(s);
    }
    for(;;)
    {
        s=justify(r.col(0),0);
        for(i=1;i&lt;n;i++) 
            s+="|"+justify(r.col(i),i);
        print(s);
        if (userAskedAbort()) return 1;
        r=getNextRow();
        if (r.isNull) return 1;
    }
    return 1;
}
</Script>
</Generic>
<Generic idx='1278' x='2088' y='240' id='runSelectedPin'
 deprecated='1'
