  keywords='run part graph'
  image='/multiplexer.png'
  author='Frank Vanden Berghen'
  revision='0.04'
  tags='600_System Tools'
  pdfDestination='5_21_10_run_selected_pin'>
<Description>

</Description>
<Parameters>
  <Parameter id='idMode' text='Operating mode' type='combobox'><meta>&lt;i&gt;Execute all boxes on all input pins&lt;/i&gt;&lt;i&gt;Execute the boxes on the input pin number given below&lt;/i&gt;</meta><data>0</data></Parameter>
  <Parameter id='idPinToRun' text='pin to run' type='string'></Parameter>
</Parameters>
<Script>
function init(){ return 0;}

function run()
{
    if (idMode==1)
    {
        var r;
        do{
            r=getNextRow(Number(idPinToRun));
            if (userAskedAbort()) return 1;
        } while(!r.isNull);
        return 1;
    }
    var i,r;
    for(i=0;i&lt;nPinIn;i++)
    {
        do{
            r=getNextRow(i);
            if (userAskedAbort()) return 1;
        } while(!r.isNull);
    }
    return 1;
}
</Script>
</Generic>
