<Generic idx='185' x='-2304' y='456' id='Audit DataMart'
  longName='Audit a Data Audit'
  le='1681355600671'
  abortOnMissingColumn='0'
  shape='2'
  image='/Marvin Audit.svg'
  author='Timi'
  revision='0.14'
  tags='750_BI &amp; Reporting'
  pdfDestination='5_19_5_loop_anatella_graphs'>
<Description>
&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;MS Shell Dlg 2&apos;; font-size:14px; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;
</Description>
<Parameters>
  <Parameter id='resultAnatella' text='Anatella File to Audit' type='onecolumn'><meta>0</meta><data>C1</data></Parameter>
  <Parameter id='resultSQL' text='(Optional) Anatella File to Compare' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='auditFolder' text='Subfolder Name' type='string'>Validacion</Parameter>
  <Parameter id='outDir' text='Report Directory' type='onedir'><data>:/Prueba</data></Parameter>
  <Parameter id='idSilent' text='Silent Mode?' type='bool'>1</Parameter>
  <Parameter id='idAbortAction' text='When run fails:' type='combobox'><meta>&lt;i&gt;Never Abort And No Retry&lt;/i&gt;
&lt;i&gt;Never Abort But Retry 5 Times&lt;/i&gt;
&lt;i&gt;Abort If Still Failed after 5 &quot;Retry&quot;&lt;/i&gt;
&lt;i&gt;Abort If Still Warning after 5 &quot;Retry&quot;&lt;/i&gt;</meta><data>2</data></Parameter>
  <Parameter id='idVerbosity' text='a short description' type='combobox'><meta>&lt;i&gt;Silent&lt;/i&gt;&lt;i&gt;Normal Verbosity&lt;/i&gt;&lt;i&gt;Show the logs of the executed graphs&lt;/i&gt;</meta><data>2</data></Parameter>
</Parameters>
<Script>
var param=[];
function init()
    {
    return 0;
    }
function handleReturnCode(rc)
{
    if (rc>=1) setWarningFlag();
    if ((rc>1)&amp;&amp;(idAbortAction>=2)) throw "Aborting (Errors)...";
    if ((rc>=1)&amp;&amp;(idAbortAction>=3)) throw "Aborting (Warnings)...";
}
function run()
{      
    var nRetry=5;
    var p=new ProcessRunner(nRetry);
    p.setVerbose(idVerbosity);
    var idFile=anatellaDir + "/GraphApps/01 Start Audit.anatella"
    var i=0;
    setOutputRowSize(0,1);
    for(;;)
        {
            var r=getNextRow();
            if (r.isNull) return 1;
            if (!r.isNull) 
                {
                    if (idSilent) param.push("-s");
                    param.push("-DresultAnatella="+r.col(resultAnatella));
                    if (resultSQL!=-1) 
                    { 
                        param.push("-DresultSQL="+r.col(resultSQL));
                    }
                    param.push("-DauditFolder="+auditFolder);
                    param.push("-DoutDir="+outDir);
                    handleReturnCode(p.runAnatella(idFile,param,":/"));
                }
        }
    return 1;
}
</Script>
</Generic>
