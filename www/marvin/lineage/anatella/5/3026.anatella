<?xml version="1.0" encoding="utf-8"?>
<ANATELLA version='3.04'>
<GlobalParameters wDirLoc='1' dataDirRead='D:/ProdAnatella/DM8' fileParameterDir='D:/ProdAnatella/DM8'>
</GlobalParameters>
<WorkingSpace></WorkingSpace>
<ACTIONS>
<Generic idx='35' v='2.44' x='228' y='-144' id='loopAnatellaGraphs2'
  longName='run a Graph in a loop'
  le='1642253008451'
  abortOnMissingColumn='0'
  shape='3'
  keywords='loop run anatella graph meta control process .anatella'
  image='/loop.svg'
  author='Frank Vanden Berghen'
  revision='0.11'
  tags='600_System Tools'
  pdfDestination='5_21_5_loop_anatella_graphs'>
<Description>
Run one Anatella graphs in a loop
</Description>
<Parameters>
  <Parameter id='idFile' text='Anatella Graph to run inside loop' type='onefileopen'><meta>Anatella files (*.anatella)</meta><data>:/ExtraccionLoop.anatella</data></Parameter>
  <Parameter id='idName' text='Global Param Name' type='string'>TableName</Parameter>
  <Parameter id='idValue' text='Global Param Value' type='onecolumn'><meta>0</meta><data>TABLA</data></Parameter>
  <Parameter id='idGPV' text='Global Parameters to pass to the graph (comma-separated)' type='string'></Parameter>
  <Parameter id='idClear' text='Clear the value of all Global Parameters before running the graph' type='bool'>0</Parameter>
  <Parameter id='hasCounter' text='add an iteration counter?' type='bool'>0</Parameter>
  <Parameter id='idCounterName' text='Iteration counter name' type='string'>gpcounter</Parameter>
  <Parameter id='ncpu' text='run N graph(s) in parallel. N=?' type='string'>4</Parameter>
  <Parameter id='idSilent' text='Silent Mode?' type='bool'>1</Parameter>
  <Parameter id='idVerbosity' text='Message Verbosity inside Log' type='combobox'><meta>&lt;i&gt;Silent&lt;/i&gt;&lt;i&gt;Normal Verbosity&lt;/i&gt;&lt;i&gt;Show the logs of the executed graphs&lt;/i&gt;</meta><data>2</data></Parameter>
  <Parameter id='idAbortAction' text='When run fails:' type='combobox'><meta>&lt;i&gt;Never Abort And No Retry&lt;/i&gt;
&lt;i&gt;Never Abort But Retry 5 Times&lt;/i&gt;
&lt;i&gt;Abort If Still Failed after 1 &quot;Retry&quot;&lt;/i&gt;
&lt;i&gt;Abort If Still Warning after 1 &quot;Retry&quot;&lt;/i&gt;
&lt;i&gt;Abort If Still Failed after 5 &quot;Retry&quot;&lt;/i&gt;
&lt;i&gt;Abort If Still Warning after 5 &quot;Retry&quot;&lt;/i&gt;</meta><data>0</data></Parameter>
</Parameters>
<Script>
function init(){return 0;}

function handleReturnCode(rc)
{
    if (rc!=0) setWarningFlag();
    if (((rc>1)||(rc&lt;0))&amp;&amp;(idAbortAction>=2)) throw "Aborting (Errors)...";
    if ((rc!=0)&amp;&amp;(idAbortAction>=3)) throw "Aborting (Warnings)...";
}

function run()
{
    var nRetry=1;
    if (idAbortAction>3) { idAbortAction-=2; nRetry=5; }
    var p=new ProcessRunner(nRetry);
    p.setVerbose(idVerbosity);
    ncpu=Math.max(1,Number(ncpu));
    if (ncpu>70)
        throw "ERROR: Unusually high parameter for parallel execution: Are you sure that you want to execute this loop using "+ncpu+" CPU's? If yes, please remove this sanity check for the code of the Action.";
    idName=String(idName);
    idCounterName=String(idCounterName);
    var defaultGP=[];
    {
        var s=trim(idGPV);
        if (s.length>0)
        {
            s=s.split(",");
            var i=s.length,k;
            while(i--)
            {
                k=trim(s[i]);
                if (k.length>0) defaultGP.push("-D"+k+"="+eval(k));
            }
        }
    }
    var i=0,rc;
    for(;;)
    {
        var r=getNextRow();
        if (r.isNull) break;
    
        var param=[];
        if (Number(idClear)!=0) param.push("-c");
        if (idSilent) param.push("-s");
        if ((idValue>=0)&amp;&amp;(idName.length)) param.push("-D"+idName+"="+r.col(idValue));
        if (hasCounter&amp;&amp;(idCounterName.length)) { param.push("-D"+idCounterName+"="+i); i++; }
        param=param.concat(defaultGP);
    
        if (ncpu>1) p.addAnatellaJob(idFile,param);
        else 
        {
            rc=p.runAnatella(idFile,param);
            if (nRetry==5)
            {
               if (idAbortAction==2)
               {
                  if (rc>1) rc=p.runAnatella(idFile,param);
                  if (rc>1) rc=p.runAnatella(idFile,param);
                  if (rc>1) rc=p.runAnatella(idFile,param);
                  if (rc>1) rc=p.runAnatella(idFile,param);
               } else  if (idAbortAction==3)
               {
                  if (rc>=1) rc=p.runAnatella(idFile,param);
                  if (rc>=1) rc=p.runAnatella(idFile,param);
                  if (rc>=1) rc=p.runAnatella(idFile,param);
                  if (rc>=1) rc=p.runAnatella(idFile,param);
               }
            }
            handleReturnCode(rc);
        }
    }

    if (ncpu>1) handleReturnCode(p.run(ncpu,idAbortAction));
    return 1;
}
</Script>
</Generic>
