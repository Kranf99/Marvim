<OracleOCI module='Oracle' idx='201' v='2.54' x='-2184' y='-1452' connString='(DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = PRODUCCION)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = IDDLEM01)
        (SERVER=DEDICATED)
    )
  )' user='idu_data_bi' passwordc='LAAAAMgBAADIAQAAKwlsP/sDVmzdbdQ/NjuwvuZp0o4avm94fZCzSpM33kU=' newMode='0'>
<SQL>
select F.NU_FICHA_REG, F.TI_DOC_REG_FICHA,E.FE_CREA_AUDI 
FROM IDOCAPTURA.CTTV_FICHA_REGISTRAL F
        LEFT JOIN IDOCAPTURA.CTTX_DOC_ADJUNTO_TRAMITE D
          ON F.NU_FICHA_REG = D.NU_FICHA_REG
         AND F.TI_DOC_REG_FICHA = D.TI_DOC_REG_FICHA
         AND D.CO_DOC_ADJ = &apos;165&apos; --165 RECIBO
        JOIN IDOCAPTURA.CTTX_ESTACION_TRAMITE E
          ON E.NU_FICHA_REG = F.NU_FICHA_REG
         AND E.TI_DOC_REG_FICHA = F.TI_DOC_REG_FICHA
         AND E.ES_FINAL = &apos;6&apos;
         AND TRUNC(E.FE_CREA_AUDI) = to_date(&apos;2023-07-17&apos;,&apos;yyyy-MM-dd&apos;) ---FECHA CALCULO
        LEFT JOIN IDOTABMAESTRA.GETM_ANI U
          ON F.NU_DNI_TITULAR = U.NU_DNI
       WHERE F.CO_RUTA IN (&apos;1&apos;, &apos;2&apos;)
         AND F.ES_FICHA_REG IN (&apos;1&apos;, &apos;4&apos;)
         AND F.CO_TIPO_CAPTURA IN (&apos;1&apos;, &apos;2&apos;, &apos;4&apos;)
         AND NOT EXISTS ---QUE NO SEA MESA DE PARTES
       (SELECT 1
                FROM IDOCAPTURA.PRTV_TRAMITES_MPV V
               WHERE V.NU_FICHA = F.NU_FICHA_REG
                 AND V.TI_FICHA = F.TI_DOC_REG_FICHA)
</SQL>
</OracleOCI>
