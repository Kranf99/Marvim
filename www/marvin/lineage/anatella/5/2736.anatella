<SQL>
select c.NU_FICHA_REG, c.TI_DOC_REG_FICHA,t.FE_CREA_AUDI 
FROM IDOCAPTURA.CTTV_FICHA_REGISTRAL C
       INNER JOIN CTTX_ESTACION_TRAMITE T
          ON C.NU_FICHA_REG = T.NU_FICHA_REG
         AND C.TI_DOC_REG_FICHA = T.TI_DOC_REG_FICHA
         AND T.ES_FINAL = &apos;5&apos;
         AND TRUNC(T.FE_CREA_AUDI) = to_date(&apos;2023-07-17&apos;,&apos;yyyy-MM-dd&apos;)
       INNER JOIN IDCWEB.ICTV_TRAMITE_WEB W
          ON W.NU_SOLICITUD = C.NU_SOL_WEB
       INNER JOIN IDOTABMAESTRA.GETM_ANI A
          ON C.NU_DNI_TITULAR = A.NU_DNI
        LEFT JOIN IDOCAPTURA.CTTX_DOC_ADJUNTO_TRAMITE D
          ON C.NU_FICHA_REG = D.NU_FICHA_REG
         AND C.TI_DOC_REG_FICHA = D.TI_DOC_REG_FICHA
         AND D.CO_DOC_ADJ = &apos;165&apos; --165 RECIBO
       WHERE C.CO_TIPO_CAPTURA = &apos;3&apos;
         AND C.CO_RUTA = &apos;2&apos;
         AND C.ES_FICHA_REG = &apos;1&apos;
</SQL>
</OracleOCI>
