  <c>NU_FICHA_REG</c><c>TI_DOC_REG_FICHA</c><c>FE_CREA_AUDI</c></Append>
<RowCounter idx='569' x='-1776' y='1322' label='CounterID_570' compact='0'/>
<OracleOCI module='Oracle' idx='570' v='2.54' x='-2448' y='1944' connString='(DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = PRODUCCION)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = IDDLEM01)
        (SERVER=DEDICATED)
    )
  )' user='idu_data_bi' passwordc='LAAAAMgBAADIAQAAKwlsP/sDVmzdbdQ/NjuwvuZp0o4avm94fZCzSpM33kU=' newMode='0'>
<SQL>
select a.NU_FICHA_REG, a.TI_DOC_REG_FICHA,a.FE_CREA_AUDI 
FROM IDOCAPTURA.CTTV_FICHA_REGISTRAL A
       INNER JOIN IDCWEB.ICTV_TRAMITE_WEB C
          ON C.NU_SOLICITUD = A.NU_SOL_WEB
         AND C.IN_RECTIFICACION IN
             (&apos;07&apos;, &apos;08&apos;, &apos;09&apos;, &apos;10&apos;, &apos;11&apos;, &apos;12&apos;, &apos;13&apos;, &apos;14&apos;)
        LEFT JOIN IDCWEB.ICTV_CTA_CTE_CIUDADANO_WEB X
          ON X.NU_SOLICITUD = A.NU_SOL_WEB
        LEFT JOIN IDOTABMAESTRA.GETM_ANI U
          ON A.NU_DNI_TITULAR = U.NU_DNI
       WHERE TRUNC(A.FE_MODI_AUDI) = to_date(&apos;2023-07-17&apos;,&apos;yyyy-MM-dd&apos;)
         AND A.ES_FICHA_REG = &apos;0&apos;
         AND A.IN_EVALUACION_FOTO = &apos;3&apos;
