         AND F.CO_TIPO_CAPTURA IN (&apos;1&apos;, &apos;2&apos;, &apos;4&apos;)
         AND E.NU_SEC_ESTACION =
             (SELECT MAX(NU_SEC_ESTACION)
                FROM IDOCAPTURA.CTTX_ESTACION_TRAMITE
               WHERE TI_DOC_REG_FICHA = E.TI_DOC_REG_FICHA
                 AND NU_FICHA_REG = E.NU_FICHA_REG
                 AND TRUNC(FE_CREA_AUDI) &lt;= to_date(&apos;2023-08-16&apos;,&apos;yyyy-MM-dd&apos;))
