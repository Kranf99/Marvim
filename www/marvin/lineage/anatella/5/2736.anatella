        LEFT JOIN IDOTABMAESTRA.GETM_ANI U
          ON F.NU_DNI_TITULAR = U.NU_DNI
       WHERE F.CO_RUTA IN (&apos;1&apos;, &apos;2&apos;)
         AND F.ES_TRAMITE IN (&apos;C&apos;, &apos;P&apos;, &apos;M&apos;, &apos;+&apos;, &apos;&quot;&apos;)
         AND F.ES_FICHA_REG = &apos;1&apos;
         AND F.CO_TIPO_CAPTURA IN (&apos;1&apos;, &apos;2&apos;, &apos;4&apos;)
         AND E.NU_SEC_ESTACION =
             (SELECT MAX(NU_SEC_ESTACION)
                FROM IDOCAPTURA.CTTX_ESTACION_TRAMITE
               WHERE TI_DOC_REG_FICHA = E.TI_DOC_REG_FICHA
                 AND NU_FICHA_REG = E.NU_FICHA_REG
                 AND TRUNC(FE_CREA_AUDI) &lt;= to_date(&apos;2023-07-17&apos;,&apos;yyyy-MM-dd&apos;))
         AND TRUNC(F.FE_MODI_AUDI) &lt;= to_date(&apos;2023-07-17&apos;,&apos;yyyy-MM-dd&apos;)
</SQL>
</OracleOCI>
<OracleOCI module='Oracle' idx='597' v='2.54' x='-2424' y='3588' connString='(DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = PRODUCCION)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = IDDLEM01)
        (SERVER=DEDICATED)
    )
  )' user='idu_data_bi' passwordc='LAAAAMgBAADIAQAAKwlsP/sDVmzdbdQ/NjuwvuZp0o4avm94fZCzSpM33kU=' newMode='0'>
<SQL>
select f.NU_FICHA_REG, f.TI_DOC_REG_FICHA,f.FE_CREA_AUDI
FROM IDOCAPTURA.CTTV_FICHA_REGISTRAL F
       INNER JOIN IDOCAPTURA.CTTX_ESTACION_TRAMITE E
          ON E.TI_DOC_REG_FICHA = F.TI_DOC_REG_FICHA
         AND E.NU_FICHA_REG = F.NU_FICHA_REG
         AND E.ES_FINAL IN (&apos;@&apos;, &apos;$&apos;, &apos;|&apos;)
        JOIN IDCWEB.ICTV_TRAMITE_WEB W
          ON W.NU_SOLICITUD = F.NU_SOL_WEB
        LEFT JOIN IDOCAPTURA.CTTX_DOC_ADJUNTO_TRAMITE D
          ON F.NU_FICHA_REG = D.NU_FICHA_REG
         AND F.TI_DOC_REG_FICHA = D.TI_DOC_REG_FICHA
         AND D.CO_DOC_ADJ = &apos;165&apos; --165 RECIBO
        LEFT JOIN IDOTABMAESTRA.GETM_ANI U
          ON F.NU_DNI_TITULAR = U.NU_DNI
       WHERE F.CO_RUTA = &apos;2&apos;
         AND F.ES_TRAMITE IN (&apos;C&apos;, &apos;P&apos;, &apos;M&apos;, &apos;+&apos;, &apos;&quot;&apos;)
         AND F.ES_FICHA_REG = &apos;1&apos;
         AND F.CO_TIPO_CAPTURA = &apos;3&apos;
         AND E.NU_SEC_ESTACION =
             (SELECT MAX(NU_SEC_ESTACION)
                FROM IDOCAPTURA.CTTX_ESTACION_TRAMITE
               WHERE TI_DOC_REG_FICHA = E.TI_DOC_REG_FICHA
                 AND NU_FICHA_REG = E.NU_FICHA_REG
                 AND TRUNC(FE_CREA_AUDI) &lt;= to_date(&apos;2023-07-17&apos;,&apos;yyyy-MM-dd&apos;))
         AND TRUNC(F.FE_MODI_AUDI) &lt;= to_date(&apos;2023-07-17&apos;,&apos;yyyy-MM-dd&apos;)
</SQL>
</OracleOCI>
