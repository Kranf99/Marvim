        LEFT JOIN IDOCAPTURA.PRTX_DOC_ADJUNTO_TRAMITE D
          ON C.NU_FICHA_REG = D.NU_FICHA_REG
         AND C.TI_DOC_REG_FICHA = D.TI_DOC_REG_FICHA
