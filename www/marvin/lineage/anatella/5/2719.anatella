<OracleOCI module='Oracle' idx='711' v='2.54' x='-5736' y='4584' connString='(DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = PRODUCCION)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = IDDLEM01)
        (SERVER=DEDICATED)
    )
  )' user='idu_data_bi' passwordc='LAAAAC8DAAAvAwAADgW9QL0o+vlnt5/2bMIIz4M/udY7imWqTRB8+kCudmg=' newMode='0'>
<SQL>
Select  f.NU_FICHA_REG,TRUNC(f.FE_MODI_AUDI)
FROM IDOCAPTURA.CTTV_FICHA_REGISTRAL F
        JOIN IDCWEB.ICTV_TRAMITE_WEB W
          ON W.NU_SOLICITUD = F.NU_SOL_WEB
         AND W.IN_RECTIFICACION IN
             (&apos;07&apos;, &apos;08&apos;, &apos;09&apos;, &apos;10&apos;, &apos;11&apos;, &apos;12&apos;, &apos;13&apos;, &apos;14&apos;)
        
        
       WHERE F.CO_RUTA = &apos;4&apos;
         AND F.ES_TRAMITE = &apos;4&apos;
         AND F.ES_FICHA_REG = &apos;1&apos;
         AND F.CO_TIPO_CAPTURA = &apos;3&apos;
         AND NOT EXISTS
       (SELECT 1
                FROM IDOCAPTURA.CTTX_ESTACION_TRAMITE
               WHERE NU_FICHA_REG = F.NU_FICHA_REG
                 AND TI_DOC_REG_FICHA = F.TI_DOC_REG_FICHA
                 AND ES_FINAL = &apos;?&apos;
                 AND TRUNC(FE_CREA_AUDI) &gt; to_date(&apos;2023-08-14&apos;,&apos;yyyy-MM-dd&apos;))
         AND TRUNC(F.FE_MODI_AUDI) &lt;= to_date(&apos;2023-08-14&apos;,&apos;yyyy-MM-dd&apos;)
</SQL>
</OracleOCI>
<OracleOCI module='Oracle' idx='712' v='2.54' x='-5736' y='4680' connString='(DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = PRODUCCION)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = IDDLEM01)
        (SERVER=DEDICATED)
    )
  )' user='idu_data_bi' passwordc='LAAAAC8DAAAvAwAADgW9QL0o+vlnt5/2bMIIz4M/udY7imWqTRB8+kCudmg=' newMode='0'>
<SQL>
Select  f.NU_FICHA_REG,TRUNC(f.FE_MODI_AUDI)
 FROM IDOCAPTURA.CTTV_FICHA_REGISTRAL F
       INNER JOIN IDOCAPTURA.CTTX_ESTACION_TRAMITE E
          ON E.TI_DOC_REG_FICHA = F.TI_DOC_REG_FICHA
         AND E.NU_FICHA_REG = F.NU_FICHA_REG
         AND E.ES_FINAL IN (&apos;@&apos;, &apos;$&apos;, &apos;|&apos;)
        
        
       WHERE F.CO_RUTA IN (&apos;1&apos;, &apos;2&apos;)
         AND F.ES_TRAMITE IN (&apos;C&apos;, &apos;P&apos;, &apos;M&apos;, &apos;+&apos;, &apos;&quot;&apos;)
         AND F.ES_FICHA_REG = &apos;1&apos;
         AND F.CO_TIPO_CAPTURA IN (&apos;1&apos;, &apos;2&apos;, &apos;4&apos;)
         AND E.NU_SEC_ESTACION =
             (SELECT MAX(NU_SEC_ESTACION)
                FROM IDOCAPTURA.CTTX_ESTACION_TRAMITE
               WHERE TI_DOC_REG_FICHA = E.TI_DOC_REG_FICHA
                 AND NU_FICHA_REG = E.NU_FICHA_REG
                 AND TRUNC(FE_CREA_AUDI) &lt;= to_date(&apos;2023-08-14&apos;,&apos;yyyy-MM-dd&apos;))
         AND TRUNC(F.FE_MODI_AUDI) &lt;= to_date(&apos;2023-08-14&apos;,&apos;yyyy-MM-dd&apos;)
</SQL>
</OracleOCI>
