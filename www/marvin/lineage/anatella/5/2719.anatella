<RowCounter idx='636' x='-5640' y='1178' label='CounterID_637' compact='0'/>
<OracleOCI module='Oracle' idx='637' v='2.54' x='-5760' y='1272' connString='(DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = PRODUCCION)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = IDDLEM01)
        (SERVER=DEDICATED)
    )
  )' user='idu_data_bi' passwordc='LAAAAC8DAAAvAwAADgW9QL0o+vlnt5/2bMIIz4M/udY7imWqTRB8+kCudmg=' newMode='0'>
<SQL>
Select  F.NU_FICHA_REG,TRUNC(E.FE_MODI_AUDI)
FROM IDOCAPTURA.PRTV_FICHA_REGISTRAL F
        JOIN IDCWEB.ICTV_TRAMITE_WEB W
          ON W.NU_SOLICITUD = F.NU_SOL_WEB
        LEFT JOIN IDOCAPTURA.PRTX_DOC_ADJUNTO_TRAMITE D
          ON F.NU_FICHA_REG = D.NU_FICHA_REG
         AND F.TI_DOC_REG_FICHA = D.TI_DOC_REG_FICHA
         AND D.CO_DOC_ADJ = &apos;165&apos; --165 RECIBO
        JOIN IDOCAPTURA.PRTX_ESTACION_TRAMITE E
          ON E.NU_FICHA_REG = F.NU_FICHA_REG
         AND E.TI_DOC_REG_FICHA = F.TI_DOC_REG_FICHA
         AND E.ES_FINAL = &apos;A&apos;
         AND TRUNC(E.FE_CREA_AUDI) = to_date(&apos;2023-08-14&apos;,&apos;yyyy-MM-dd&apos;)
        LEFT JOIN IDOTABMAESTRA.GETM_ANI U
          ON F.NU_DNI_TITULAR = U.NU_DNI
       WHERE F.CO_RUTA = &apos;2&apos;
         AND F.ES_FICHA_REG = &apos;1&apos;
         AND F.CO_TIPO_CAPTURA = &apos;3&apos;
</SQL>
</OracleOCI>
