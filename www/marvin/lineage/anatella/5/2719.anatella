         AND F.ES_TRAMITE = &apos;7&apos;
         AND F.ES_FICHA_REG IN (&apos;1&apos;, &apos;4&apos;)
         AND F.CO_TIPO_CAPTURA IN (&apos;1&apos;, &apos;2&apos;, &apos;4&apos;)
         AND TRUNC(F.FE_MODI_AUDI) &lt;= to_date(&apos;2023-08-14&apos;,&apos;yyyy-MM-dd&apos;)
</SQL>
