          ON E.NU_FICHA_REG = F.NU_FICHA_REG
         AND E.TI_DOC_REG_FICHA = F.TI_DOC_REG_FICHA
         AND E.ES_INICIAL IN (&apos;C&apos;, &apos;P&apos;, &apos;M&apos;, &apos;+&apos;, &apos;&quot;&apos;)
         AND E.ES_FINAL = &apos;?&apos;
         AND TRUNC(E.FE_CREA_AUDI) = to_date(&apos;2023-08-14&apos;,&apos;yyyy-MM-dd&apos;)---FECHA CALCULO
        
       WHERE F.CO_RUTA IN (&apos;1&apos;, &apos;2&apos;)
         AND F.ES_FICHA_REG = &apos;1&apos;
         AND F.CO_TIPO_CAPTURA IN (&apos;1&apos;, &apos;2&apos;, &apos;4&apos;)
         AND EXISTS
       (SELECT 1
                FROM IDOCAPTURA.PRTX_ESTACION_TRAMITE
               WHERE TI_DOC_REG_FICHA = E.TI_DOC_REG_FICHA
                 AND NU_FICHA_REG = E.NU_FICHA_REG
                 AND ES_FINAL IN (&apos;@&apos;, &apos;$&apos;)
                 AND NU_SEC_ESTACION = E.NU_SEC_ESTACION - 1)
</SQL>
</OracleOCI>
