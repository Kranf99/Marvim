FROM IDOCAPTURA.CTTV_FICHA_REGISTRAL F
        JOIN IDCWEB.ICTV_TRAMITE_WEB W
          ON W.NU_SOLICITUD = F.NU_SOL_WEB
        
        
       WHERE F.CO_RUTA = &apos;2&apos;
         AND F.ES_TRAMITE IN (&apos;!&apos;,
                              &apos;-&apos;,
                              &apos;.&apos;,
                              &apos;&lt;&apos;,
                              &apos;&gt;&apos;,
                              &apos;B&apos;,
                              &apos;D&apos;,
                              &apos;E&apos;,
                              &apos;F&apos;,
                              &apos;K&apos;,
                              &apos;L&apos;,
