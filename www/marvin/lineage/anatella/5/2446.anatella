  <Annotation x='-2724' y='-432' size='10' bold='1' color='#228b22' anchor='79'>IDOIMPRESION.IMTC_DNIS_IMPRESION I</Annotation>
  <Annotation x='-2544' y='-576' size='10' anchor='82'>WHERE I.ES_REGI_IMPR = &apos;1&apos; --LOTE GENERADO
