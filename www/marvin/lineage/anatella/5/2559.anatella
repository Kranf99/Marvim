  <Annotation x='-3084' y='468' size='6' anchor='19'>sE FILTRA CON CO_DOC_ADJ = &quot;165&quot;</Annotation>
  <Annotation x='-2928' y='456' size='6' anchor='26'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-3096' y='-204' size='6' anchor='28'>sE FILTRA ES_DNI_LOTE = 1 Ó 9</Annotation>
  <Annotation x='-1176' y='252' size='6'>SE REALIZA LEFT JOIN ENTRE LA FUENTE U Y F
POR EL CAMPO F.NU_DNI_TITULAR = U.NU_DNI</Annotation>
  <Annotation x='-1056' y='-24' size='6' anchor='31'>SE CREAN LOS CAMPOS A PARTIR DE VALORES CONSTANTES
IN_RECTIFICACION
IN_DNIE
IN_CANAL
IN_PRIORI_IMPR
P_DFE_DATA</Annotation>
