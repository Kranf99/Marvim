<TEXTANNOTATIONS>
  <Annotation x='-2304' y='300' size='6' anchor='16'>IDOIMPRESION.IMTV_CONTROL_PROCESO_DNI P</Annotation>
  <Annotation x='-1956' y='360' size='6' anchor='20'>SE FILTRA
P.CO_PROCESO = &apos;A&apos;
         AND P.CO_SUBPROCESO = &apos;08&apos;
         AND P.NU_MOVI = &apos;1&apos;
         AND P.ES_DNI_PROC IN (&apos;0&apos;,&apos;1&apos;)</Annotation>
  <Annotation x='-1776' y='360' size='6' anchor='27'>Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='1620' y='648' size='18' bold='1'>Calculo de la variable V_VIN_DECA
usando la función de 
LDFU_IN_DECA</Annotation>
  <Annotation x='-1956' y='432' size='6'>Se toman los que no coinciden</Annotation>
  <Annotation x='-2304' y='492' size='6' anchor='178'>IDOIMPRESION.IMTD_LOTE_IMPRESION</Annotation>
  <Annotation x='-2568' y='588' size='6' anchor='182'>IDOIMPRESION.IMTC_LOTE_IMPRESION</Annotation>
  <Annotation x='-2568' y='696' size='6' anchor='183'>IDOIMPRESION.IMTM_DESTINO_IMPRESION</Annotation>
