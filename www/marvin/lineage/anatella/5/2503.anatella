  <Annotation x='-1668' y='960' size='6' anchor='191'>IDOCAPTURA.PRTX_DOC_ADJUNTO_TRAMITE</Annotation>
  <Annotation x='-1956' y='552' size='6' anchor='179'>ES_DNI_LOTE=&quot;1&quot;</Annotation>
  <Annotation x='-2220' y='660' size='6' anchor='184'>ES_LOTE_IMPR = &quot;1&quot;</Annotation>
  <Annotation x='-1680' y='552' size='6' anchor='246'>Se renombran los cmapos por 
V_VNU_FICHA_REG
V_VTI_DOC_REG_FICHA</Annotation>
  <Annotation x='-1644' y='180' size='6' anchor='177'>sE RENOMBRA EL CAMPO
us_crea_audi --&gt; co_servidor</Annotation>
  <Annotation x='-1872' y='720' size='6' anchor='248'>se realiza trunc a la variable FE_CREA_AUDI</Annotation>
  <Annotation x='-1704' y='720' size='6' anchor='247'>Se renombran los campos
V_VIN_PRIORI_IMPR
V_VCO_GRUPO_IMPRESION
V_DFE_GENERA_LOTE
V_VCO_LOCAL_IMPRESION</Annotation>
  <Annotation x='-1200' y='876' size='6' anchor='193'>nvl(IN_DNIE,&quot;0&quot;) = &quot;0&quot; &amp;&amp; ES_FICHA_REG= &quot;1&quot;</Annotation>
  <Annotation x='-1200' y='972' size='6' anchor='192'>CO_DOC_ADJ=&quot;165&quot;</Annotation>
  <Annotation x='-1032' y='816' size='6' anchor='203'>Se pone el prefijo F.</Annotation>
  <Annotation x='-1032' y='1020' size='6' anchor='204'>Se adiciona el prefijo D.</Annotation>
  <Annotation x='-1296' y='1068' size='6' anchor='205'>LDFU_FE_ENVIO</Annotation>
  <Annotation x='-1308' y='1188' size='6' anchor='209'>LDFU_FE_RECE_PROC</Annotation>
