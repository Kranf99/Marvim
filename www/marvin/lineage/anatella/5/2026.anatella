<ListFiles module='DefaultActions' idx='8' v='2.37' x='-132' y='-768' filter='*.*_anatella'/>
<Generic idx='9' x='24' y='-768' id='simpleFileOps'
  longName='Simple File Operations'
  le='1648063873179'
  abortOnMissingColumn='0'
  shape='3'
  keywords='file copy move rename delete'
  image='/fileOps.svg'
  author='Frank Vanden Berghen'
  revision='0.09'
  tags='600_System Tools'>
<Description>
</Description>
<Parameters>
  <Parameter id='idMode' text='Mode' type='combobox'><meta>&lt;i&gt;Copy Files&lt;/i&gt;&lt;i&gt;Move (or Rename) Files&lt;/i&gt;&lt;i&gt;Delete Files&lt;/i&gt;&lt;i&gt;Create Dir&lt;/i&gt;</meta><data>2</data></Parameter>
  <Parameter id='idSource' text='Source File' type='onecolumn'><meta>0</meta><data>fileName</data></Parameter>
  <Parameter id='idDestination' text='Destination File' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='idNAttempts' text='Maximum number of attempts' type='double'>2</Parameter>
  <Parameter id='msToSleep' text='Wait for X milliseconds between each attempt. X=?' type='double'>5000</Parameter>
  <Parameter id='idAbort' text='Abort if this still fails after all the attempts' type='bool'>1</Parameter>
  <Parameter id='idOverwrite' text='Overwrite destination File (for copy/move ops.)' type='bool'>1</Parameter>
</Parameters>
<Script>
var mr,attemptNumber,attemptLeft;
function parallelRun(v) { return true; }
function init()
{
    var r=getCurrentRow();
    if (r.isNull) return 0;
    setOutputRowSize(0,r.nColumn+1);
    idNAttempts--;
    if (!(idNAttempts>=0)) idNAttempts=0;
    mr=new Row(1);
    rowSetColumnName(mr,0,"Op_Status");
    rowSetMetaType(mr,0,'K');
    switch(idMode)
    {
    case 0:
    case 1:
        if (idSource&lt;0) throw "SimpleFileOps: no source?";
        if (idDestination&lt;0) throw "SimpleFileOps: no destination?";
        break;
    case 2:
    case 3:
        if (idSource&lt;0) throw "SimpleFileOps: no source?";
        break;
    }
    return 0;
}
function doWait(s)
{
    attemptLeft--;
    print(s+" Failed: Waiting "+msToSleep+"ms before next attempt...");
    sleep(msToSleep);
    attemptNumber++;
    print("Sleep finished: Attempting "+s+" again ("+attemptNumber+")...");
}
function overwrite(s)
{
    if (!idOverwrite) return 0;
    for(;;)
    {
        a=fileDelete(s,true);
        if (a&amp;&amp;(!fileExist(s))) break;
        if (!attemptLeft)
        {
            if (idAbort)  throw "Error Overwriting File "+s;
            break;
        }
        doWait("Overwrite");
        if (userAskedAbort()) return 1;
    }
    return 0;
}
function run()
{
    var r=getNextRow();
    if (r.isNull) return 1;
    var a;
    attemptNumber=1;
    attemptLeft=idNAttempts;
    switch(idMode)
    {
    case 0:
        {
            var s=r.col(idSource),d=r.col(idDestination);
            if (overwrite(d)) return 1;
            for(;;)
            {
                a=fileCopy(s,d,true);
                if (a) break;
                if (!attemptLeft)
                {
                    if (idAbort)  throw "Error Copying File "+s;
                    break;
                }
                doWait("Copy");
                if (userAskedAbort()) return 1;
            }
            break;
        }
    case 1:
        {
            var s=r.col(idSource),d=r.col(idDestination);
            if (overwrite(d)) return 1;
            for(;;)
            {
                a=fileMove(s,d,true);
                if (a) break;
                if (!attemptLeft)
                {
                    if (idAbort)  throw "Error Moving File "+s;
                    break;
                }
                doWait("Move");
                if (userAskedAbort()) return 1;
            }
            break;
        }
    case 2:
        {
            var s=r.col(idSource);
            for(;;)
            {
                a=fileDelete(s,true);
                if (a&amp;&amp;(!fileExist(s))) break;
                if (!attemptLeft)
                {
                    if (idAbort)  throw "Error Deleting File "+s;
                    break;
                }
                doWait("Delete");
                if (userAskedAbort()) return 1;
            }
            break;
        }
    case 3:
        {
            var s=r.col(idSource);
            mkDir(s);
            a=fileExist(s);
            break;
        }
    }
    r.write(); 
    mr.setColumn(0,a?1:0);
    mr.write();
    writeEOL();
    return 0;
}
</Script>
</Generic>
