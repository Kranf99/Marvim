    <InputVar column='C.FE_CREA_AUDI' label='C_FE_CREA_AUDI' isNumber='0'/>
    <InputVar column='U.FE_CADUCIDAD' label='U_FE_CADUCIDAD' isNumber='0'/>
    <InputVar column='W.CO_SUBTIPO_TRAMITE' label='W_CO_SUBTIPO_TRAMITE' isNumber='0'/>
    <InputVar column='W.NU_DNI_SVB' label='W_NU_DNI_SVB' isNumber='0'/>
    <InputVar column='W.FE_TRAMITE_WEB' label='W_FE_TRAMITE_WEB' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='TI_DOC_REG_FICHA' meta='U'>trim(F_TI_DOC_REG_FICHA)</OutputVar>
    <OutputVar name='IM_RECIBO' meta='U'>nvl(D_IM_DOC_ADJ,"0")</OutputVar>
    <OutputVar name='FE_GENERA_LOTE' meta='U'>left(C_FE_CREA_AUDI,8)</OutputVar>
    <OutputVar name='FE_CADUCIDAD' meta='U'>left(U_FE_CADUCIDAD,8)</OutputVar>
    <OutputVar name='IN_CANAL' meta='U'>(W_CO_SUBTIPO_TRAMITE="2"?"0"//itoa(C_TIPO_WEB):
(W_CO_SUBTIPO_TRAMITE="N"?"0"//itoa(C_TIPO_BN):
(W_CO_SUBTIPO_TRAMITE="W"?"0"//itoa(C_TIPO_PVM):
(W_CO_SUBTIPO_TRAMITE="Y"?"0"//itoa(C_TIPO_MOVIL):
(W_CO_SUBTIPO_TRAMITE="V"?(W_NU_DNI_SVB= _nullS?"0"//itoa(C_TIPO_WEB):"0"//itoa(C_TIPO_PVM)):_nullS)))))</OutputVar>
    <OutputVar name='FE_REGI' meta='U'>left(W_FE_TRAMITE_WEB,8)</OutputVar>
  </OutputVars>
</Calculator>
<Calculator forceHDBuffering='1' module='MathParser' idx='124' x='312' y='96'>
  <InputVars>
    <InputVar column='W.TI_TRAMITE' label='P_VCO_TIPO_TRAMITE' isNumber='0'/>
    <InputVar column='W.IN_RECTIFICACION' label='P_VIN_RECTIFICACION' isNumber='0'/>
    <InputVar column='F.IN_DECADACTILAR_ABIS' label='P_VDE_VALOR' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='IN_ABIS' meta='U'>(P_VDE_VALOR != _nullS ?(P_VDE_VALOR != "0" ?
		"1":
		"0"):
	(P_VCO_TIPO_TRAMITE= "D"?
		"0":
		(P_VCO_TIPO_TRAMITE = "R"?
			(nvl(P_VIN_RECTIFICACION, "00") != "07" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "08" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "09" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "10" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "11" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "12" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "13" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "14"?
				"0":
				_nullS):
			_nullS)))</OutputVar>
  </OutputVars>
</Calculator>
