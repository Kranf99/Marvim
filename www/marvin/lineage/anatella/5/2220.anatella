<TEXTANNOTATIONS>
  <Annotation x='-1908' y='288' anchor='10'>IDOCAPTURA.CTTV_FICHA_REGISTRAL</Annotation>
  <Annotation x='-1548' y='360' size='6' anchor='16'>Filtro
- ES_FICHA_REG = 1
- ES_TRAMITE = 1,2,3,0
- CO_RUTA = 1,2,3
- CO_TIPO_CAPTURA = 1,2,4
- FE_MODI_AUDI &lt;= P_DFE_DATA</Annotation>
  <Annotation x='-1428' y='360' size='6' anchor='23'>se crea llave de union fkey
NU_FICHA_REG//&quot;_&quot;//TI_DOC_REG_FICHA</Annotation>
  <Annotation x='-1908' y='466' size='6' anchor='44'>IDOCAPTURA.CTTX_DOC_ADJUNTO_TRAMITE</Annotation>
  <Annotation x='-1032' y='672' size='6' anchor='45'>IDOTABMAESTRA.GETM_ANI</Annotation>
  <Annotation x='-1440' y='540' size='6' anchor='48'>Se construye la llave de union fKey
NU_FICHA_REG//&quot;_&quot;//TI_DOC_REG_FICHA</Annotation>
  <Annotation x='132' y='624' size='6' anchor='65'>IDOCAPTURA.CTTR_SECUENCIA_FICHA_DECA</Annotation>
  <Annotation x='312' y='624' size='6' anchor='66'>Se filtra ES_RANGO_FICHA = 1</Annotation>
  <Annotation x='528' y='612' size='6' anchor='72'>Se realiza cruce por el campo TI_DOC_REG_FICHA
y el campo TI_FICHA, tomando la intersección entre ambos</Annotation>
  <Annotation x='984' y='516' size='6' anchor='76'>Se calcula el campo IN_DECA</Annotation>
  <Annotation x='-84' y='384' size='6' anchor='147'>Se construye la función de LDFU_IN_ABIS
LDPK_ETL_LPROC_DNI.LDFU_IN_ABIS(F.CO_RUTA,
                                             F.TI_DOC_REG_FICHA,
                                             F.IN_ABIS,
                                             F.CO_TIPO_CAPTURA,
                                             F.CO_TIPO_TRAMITE,
                                             F.CO_SUBTIPO_TRAMITE)</Annotation>
  <Annotation x='-1284' y='528' size='6' anchor='50'>Se ordena el campo llave fkey</Annotation>
  <Annotation x='-1140' y='528' size='6' anchor='49'>Se eliminan duplicados por el campo llave fkey</Annotation>
  <Annotation x='-480' y='372' size='6' anchor='144'>Se crean las variables a partir de valores constantes
- CO_CORE
- CO_PROCESO
- CO_ETAPA
- NU_HORA
- SYSDATE
- FE_DATA
- FE_ENVIO_PROC
- IN_APROBADO</Annotation>
  <Annotation x='-348' y='180' size='6' anchor='145'>se crean nuevasvariablescondicionadas por otros campos
- IN_RECTIFICACION
- IN_DNIE
- IN_CANAL
- FE_REGI
- IM_RECIBO</Annotation>
  <Annotation x='-276' y='432' size='6' anchor='146'>se actualizan variables y se crean en función a los CASE
- CO_CONTINENTE_DOMICILIO
- CO_PAIS_DOMICILIO
- CO_DEPARTAMENTO_DOMICILIO
- CO_PROVINCIA_DOMICLIO
- CO_DISTRITO_DOMICILIO
- FE_NACI
- CO_ESTADO_CIVIL
- CO_GRADO_INSTRUCCIÓN
- IN_DONA_ORGANO</Annotation>
  <Annotation x='1116' y='204' size='6' anchor='157'>Se renombran los campos de acuerdo al select</Annotation>
  <Annotation x='1248' y='384' size='6' anchor='156'>Se seleccionan los campos que son necesarios en el proceso final</Annotation>
