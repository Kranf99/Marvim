<TEXTANNOTATIONS>
  <Annotation x='-348' y='348' size='6' anchor='12'>Update variable:
-ti_doc_reg_ficha se elimina espacios
-in_dnie: Se evaluan los valores nulos
           se cambian por 0</Annotation>
  <Annotation x='-300' y='420' size='6' anchor='15'>Nuevas variables:
- IN_RECTIFICACION: Si el campo co_tipo_captura = 1 
marca como NN en caso contrario como SI</Annotation>
  <Annotation x='-24' y='360' size='6' anchor='52'>Se construye la función de LDFU_IN_ABIS
LDPK_ETL_LPROC_DNI.LDFU_IN_ABIS(F.CO_RUTA,
                                             F.TI_DOC_REG_FICHA,
                                             F.IN_ABIS,
                                             F.CO_TIPO_CAPTURA,
                                             F.CO_TIPO_TRAMITE,
                                             F.CO_SUBTIPO_TRAMITE)</Annotation>
  <Annotation x='-108' y='132' size='6' anchor='51'>Se realiza la actualiza de los campo
CO_CONTINENTE_DOMICILIO,
       CO_PAIS_DOMICILIO,
       CO_DEPARTAMENTO_DOMICILIO,
       CO_PROVINCIA_DOMICILIO,
       CO_DISTRITO_DOMICILIO,
       FE_NACIMIENTO
       CO_ESTADO_CIVIL,
       CO_GRADO_INSTRUCCION,
       CO_RESTRICCION,
       IN_DONA_ORGANO</Annotation>
  <Annotation x='-1248' y='408' anchor='45'>IDOTABMAESTRA.GETM_ANI U</Annotation>
  <Annotation x='216' y='156' size='6' anchor='58'>Se crean los campos
IN_CANAL
IN_APROBADO
CO_SERVIDOR
FE_ENVIO_PROC
FE_DATA
CO_CORE
CO_ETAPA
FE_CARGA_BI
CO_PROCESO</Annotation>
  <Annotation x='672' y='372' size='6' bold='1'>LDPK_ETL_LPROC_DNI.LDFU_IN_DECA</Annotation>
  <Annotation x='168' y='576' size='6' anchor='65'>IDOCAPTURA.CTTR_SECUENCIA_FICHA_DECA</Annotation>
  <Annotation x='348' y='576' size='6' anchor='66'>Se filtra ES_RANGO_FICHA = 1</Annotation>
  <Annotation x='564' y='564' size='6' anchor='72'>Se realiza cruce por el campo TI_DOC_REG_FICHA
y el campo TI_FICHA, tomando la intersección entre ambos</Annotation>
  <Annotation x='708' y='408' size='6' anchor='75'>Se calcula el campo IN_DECA</Annotation>
  <Annotation x='1188' y='396' size='6' anchor='64'>Se renombra los campos ya para la unión final</Annotation>
  <Annotation x='1296' y='360' size='6' anchor='63'>Se seleccionan los campos necesarios</Annotation>
  <Annotation x='-1188' y='564' anchor='157'>(CO_TIPO_CAPTURA = 1 || CO_TIPO_CAPTURA = 2 || CO_TIPO_CAPTURA= 4)
 &amp;&amp; (CO_RUTA =1 || CO_RUTA= 2 || CO_RUTA=3) 
 &amp;&amp; (ES_FICHA_REG=1)</Annotation>
  <Annotation x='-1608' y='276' bold='1' color='#228b22' anchor='145'>CRUCE_FICHA_ESTACION_CTTX_hoy</Annotation>
  <Annotation x='-1272' y='768' anchor='156'>IDOTABMAESTRA.GETM_ANI U</Annotation>
  <Annotation x='-1560' y='672' bold='1' color='#228b22' anchor='155'>CRUCE_FICHA_ESTACION_PRTX_hoy</Annotation>
  <Annotation x='-1116' y='192' size='6' anchor='146'>Se crea la llave de union NU_FICHA_REG//&quot;_&quot;//TI_DOC_REG_FICHA
FE_REGI =se toma la parte de la fecha corta
HORA: Se toma del campo FE_CREA_AUDI sola la hora</Annotation>
  <Annotation x='-1092' y='120' size='6' anchor='146'>Filtro
- CO_TIPO_CAPTURA = 1, 2 ó 4
- CO_RUTA = 1,2,3
- ES_FICHA_REF = 0,1,4</Annotation>
</TEXTANNOTATIONS>
<GROUPBOXANNOTATIONS>
  <Groupbox x='204' y='360' w='792' h='228' color='#ffdab9'/>
</GROUPBOXANNOTATIONS>
</ANATELLA>