        at[j]=rowGetSortType(rIn,k);
        k++;
    }
    return 0;
}

function run()
{
    if (i==rIn.nColumn) 
    {
        if (readAll)
        {
            var r;
            for(;;)
            {
                getNextRow();getNextRow();getNextRow();getNextRow();
                getNextRow();getNextRow();getNextRow();getNextRow();
                getNextRow();getNextRow();getNextRow();getNextRow();
                r=getNextRow();
                if (r.isNull||userAskedAbort()) return 1;
            }
        }
        return 1;
    }
    var cn=rowGetColumnName(rIn,i);
    rOut.setColumn(0,cn);
    rOut.setColumn(1,cn);
    rOut.setColumn(2,rowGetMetaType(rIn,i));
    rOut.setColumn(3,ak[i]);
    rOut.setColumn(4,at[i]);
    i++;
    rOut.write(); 
    writeEOL();
    return 0;
}
</Script>
