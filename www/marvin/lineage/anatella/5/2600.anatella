    <InputVar column='TI_DOC_REG_FICHA' label='reg' isNumber='0'/>
    <InputVar column='CO_TIPO_CAPTURA' label='captura' isNumber='0'/>
    <InputVar column='CO_TIPO_TRAMITE' label='tramite' isNumber='0'/>
    <InputVar column='CO_SUBTIPO_TRAMITE' label='subtipo' isNumber='0'/>
    <InputVar column='IN_ABIS' label='abis' isNumber='0'/>
    <InputVar column='NU_FICHA_REG' label='aaa' isNumber='0'/>
    <InputVar column='TI_DOC_REG_FICHA' label='bbb' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='IN_ABIS' meta='U' update='1'>(ruta="1" &amp;&amp; (reg="F" || reg="W" || reg="Z"))?"1":
(ruta="1" &amp;&amp; (reg="E" || reg="X") &amp;&amp; (abis="1"))?"1":
(ruta="2" &amp;&amp; (abis="1") &amp;&amp; captura="4")?"1":
(ruta="2" &amp;&amp; (reg="F" || reg="W" || reg="Z") &amp;&amp; (nvl(abis,"0")="0") &amp;&amp; captura="4" &amp;&amp; tramite="I")?"1":
(subtipo="A" &amp;&amp; tramite="D" &amp;&amp; captura="4")?"1":
((subtipo="C" || subtipo="D") &amp;&amp; tramite="R" &amp;&amp; captura="4")?"1":"0"</OutputVar>
    <OutputVar name='llaveACTANI' meta='U'>aaa//"-"//bbb</OutputVar>
  </OutputVars>
</Calculator>
