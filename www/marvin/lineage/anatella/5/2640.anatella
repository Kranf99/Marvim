  <Annotation x='-2016' y='-48' size='10' anchor='156'>IN_ABIS</Annotation>
  <Annotation x='-1548' y='120' size='10' anchor='151'>CASE
  WHEN F.CO_TIPO_TRAMITE = &apos;I&apos; THEN
   F.CO_ESTADO_CIVIL
 ELSE
U.CO_ESTADO_CIVIL
END CO_ESTADO_CIVIL,
CASE
 WHEN F.CO_TIPO_TRAMITE = &apos;I&apos; THEN
F.CO_NIVEL_EDUCA
ELSE
 U.CO_NIVEL_EDUCA
END CO_GRADO_INSTRUCCION,
