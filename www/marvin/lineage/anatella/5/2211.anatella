<Calculator keyHD='177194791218004347' module='MathParser' idx='148' x='60' y='840'>
  <InputVars>
    <InputVar column='HO_TRAMITE_WEB' isNumber='0'/>
    <InputVar column='TI_FICHA_REG' isNumber='0'/>
    <InputVar column='IN_RECTIFICACION' label='x' isNumber='0'/>
    <InputVar column='TI_TRAMITE' label='y' isNumber='0'/>
    <InputVar column='X.IM_RECIBO' label='a' isNumber='0' meta='F'/>
    <InputVar column='CO_DOC_EMI' label='b' isNumber='0'/>
    <InputVar column='CO_SUBTIPO_TRAMITE' label='z' isNumber='0'/>
    <InputVar column='NU_DNI_SVB' label='w' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='TI_DOC_REG_FICHA' meta='U'>nvl(trim(TI_FICHA_REG),"F")</OutputVar>
    <OutputVar name='CO_RUTA' meta='U'>(x="07"|| x="08"|| x="09"||x= "10"|| x="11"||x= "12"|| x="13"|| x="14"|| x="15"|| x="16"|| x="17"|| x="18"|| x="19"|| x="20"|| x="21"|| x="22"?"4":(y="R"?"2":"4"))</OutputVar>
    <OutputVar name='CO_TIPO_PAGO' meta='U'>(a =_nullS?"57":"0")</OutputVar>
    <OutputVar name='IN_DNIE' meta='U'>(b="5"?"1":"0")</OutputVar>
    <OutputVar name='C_TIP' meta='U'>(z="2"?C_TIPO_WEB:
(z="N"?C_TIPO_BN:
(z="W"?C_TIPO_PVM:
(z="Y"?C_TIPO_MOVIL:
(z="V"?(w=""?C_TIPO_WEB:C_TIPO_PVM):_nullS)))))</OutputVar>
    <OutputVar name='HORA' meta='U'>substring(HO_TRAMITE_WEB,0,2)</OutputVar>
  </OutputVars>
</Calculator>
<Calculator module='MathParser' idx='149' x='228' y='840'>
  <InputVars>
    <InputVar column='X.IM_RECIBO' label='X_IM_RECIBO' meta='F'/>
    <InputVar column='TI_TRAMITE' label='A' isNumber='0'/>
    <InputVar column='A.CO_ESTADO_CIVIL' label='B1' isNumber='0'/>
    <InputVar column='IN_EST_CIVIL' label='B2' isNumber='0'/>
    <InputVar column='CO_GRADO_INSTRU' label='C1' isNumber='0'/>
    <InputVar column='A.CO_NIVEL_EDUCA' label='C2' isNumber='0'/>
    <InputVar column='ES_DONA_ORGANO' label='D1' isNumber='0'/>
    <InputVar column='A.IN_DONA_ORGANO' label='D2' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='IM_RECIBO'>nvl(X_IM_RECIBO, 0)</OutputVar>
    <OutputVar name='CO_ESTADO_CIVIL' meta='U'>(A="I"?B1:B2)</OutputVar>
    <OutputVar name='CO_GRADO_INSTRUCCION' meta='U'>(A="I"?C1:C2)</OutputVar>
    <OutputVar name='IN_DONA_ORGANO' meta='U'>(A="I"?D1:D2)</OutputVar>
  </OutputVars>
</Calculator>
<Calculator module='MathParser' idx='150' x='384' y='840'>
  <InputVars>
    <InputVar column='TI_TRAMITE' label='P_VCO_TIPO' isNumber='0'/>
    <InputVar column='IN_RECTIFICACION' label='P_VIN_RECT' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='CO_SUBTIPO_TRAMITE' meta='U' update='1'>isNull(P_VIN_RECT) &amp;&amp; P_VCO_TIPO="D"?"B":
isNull(P_VIN_RECT) &amp;&amp; P_VCO_TIPO!="D"?"C":
P_VIN_RECT="00" &amp;&amp; P_VCO_TIPO="D"?"B":
P_VIN_RECT="00" &amp;&amp; P_VCO_TIPO!="D"?"C":
P_VIN_RECT="01" &amp;&amp; P_VCO_TIPO="D"?"B":
P_VIN_RECT="01" &amp;&amp; P_VCO_TIPO!="D"?"C":
(P_VIN_RECT="02" || P_VIN_RECT="03" ||P_VIN_RECT="04")?"C":
(P_VIN_RECT="05" || P_VIN_RECT="06")?"D":
(P_VIN_RECT = "07" || P_VIN_RECT = "08" || P_VIN_RECT = "09" || P_VIN_RECT = "10" || P_VIN_RECT = "11" ||       P_VIN_RECT = "12" || P_VIN_RECT = "13" || P_VIN_RECT = "14")?"B":
_nullS</OutputVar>
    <OutputVar name='P_VDE_VALOR' meta='U'>_nullS</OutputVar>
  </OutputVars>
</Calculator>
<Calculator module='MathParser' idx='151' x='528' y='840'>
  <InputVars>
    <InputVar column='TI_TRAMITE' label='P_VCO_TIPO_TRAMITE' isNumber='0'/>
    <InputVar column='IN_RECTIFICACION' label='P_VIN_RECTIFICACION' isNumber='0'/>
    <InputVar column='P_VDE_VALOR' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='IN_ABIS' meta='U'>(P_VDE_VALOR != _nullS ?(P_VDE_VALOR != "0" ?
		"1":
		"0"):
	(P_VCO_TIPO_TRAMITE= "D"?
		"0":
		(P_VCO_TIPO_TRAMITE = "R"?
			(nvl(P_VIN_RECTIFICACION, "00") != "07" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "08" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "09" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "10" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "11" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "12" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "13" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "14"?
				"0":
				_nullS):
			_nullS)))</OutputVar>
  </OutputVars>
</Calculator>
