<Generic idx='1790' v='3.14' x='-2376' y='204' id='loopAnatellaGraphsAdv2'
  longName='Run the different Anatella graphs given in input'
  le='1688221255410'
  abortOnMissingColumn='0'
  shape='3'
  keywords='loop run anatella graph meta control process .anatella'
  image='/loop2.svg'
  author='Frank Vanden Berghen'
  revision='0.12'
  tags='050_Run Control, 600_System Tools'
  pdfDestination='5_21_6_loop_anatella_graphs_adv'>
<Description>
Run the different Anatella graphs given in input
</Description>
<Parameters>
  <Parameter id='idFile' text='Anatella Graphs to run inside loop' type='onecolumn'><meta>0</meta><data>script</data></Parameter>
  <Parameter id='idParam' text='Global Loop Params (optional)' type='manycolumns'><meta>0</meta><data><c>Where1</c><c>Valor</c></data></Parameter>
  <Parameter id='idTest' text='Test Column (optional)' type='onecolumn'><meta>0</meta><data></data></Parameter>
  <Parameter id='idGPV' text='Global Parameters to pass to the graph (comma-separated)' type='string'>Columns1</Parameter>
  <Parameter id='idClear' text='Clear the value of all Global Parameters before running the graph' type='bool'>1</Parameter>
  <Parameter id='hasCounter' text='add an iteration counter?' type='bool'>0</Parameter>
  <Parameter id='idCounterName' text='Iteration counter name' type='string'>gpcounter</Parameter>
  <Parameter id='ncpu' text='run N graph(s) in parallel. N=?' type='string'>1</Parameter>
  <Parameter id='idSilent' text='Silent Mode?' type='bool'>1</Parameter>
  <Parameter id='idVerbosity' text='Message Verbosity inside Log' type='combobox'><meta>&lt;i&gt;Silent&lt;/i&gt;&lt;i&gt;Normal Verbosity&lt;/i&gt;&lt;i&gt;Show the logs of the executed graphs&lt;/i&gt;</meta><data>2</data></Parameter>
  <Parameter id='idAbortAction' text='When run fails:' type='combobox'><meta>&lt;i&gt;Never Abort And No Retry&lt;/i&gt;
&lt;i&gt;Never Abort But Retry 5 Times&lt;/i&gt;
&lt;i&gt;Abort If Still Failed after 1 &quot;Retry&quot;&lt;/i&gt;
&lt;i&gt;Abort If Still Warning after 1 &quot;Retry&quot;&lt;/i&gt;
&lt;i&gt;Abort If Still Failed after 5 &quot;Retry&quot;&lt;/i&gt;
&lt;i&gt;Abort If Still Warning after 5 &quot;Retry&quot;&lt;/i&gt;</meta><data>2</data></Parameter>
</Parameters>
<Script>
var p,names=[],counterValue=0,defaultGP=[],nRetry=1;
function init(){return 0;}

function strStartsWith(str, prefix) { return (str.indexOf(prefix)==0); }

function handleReturnCode(rc)
{
    if (rc!=0) setWarningFlag();
    if (((rc>1)||(rc&lt;0))&amp;&amp;(idAbortAction>=2)) throw "Aborting (Errors)...";
    if ((rc!=0)&amp;&amp;(idAbortAction>=3)) throw "Aborting (Warnings)...";
}

function launch(r,s)
{
    if((idTest&lt;0)||(r.col(idTest)))
    {
        var param=[];
        var j=idParam.length,rc;
        while(j--) param[j]=(names[j]+r.col(idParam[j]));
        if (hasCounter&amp;&amp;(idCounterName.length)) { param[j]=("-D"+idCounterName+"="+counterValue); counterValue++; j++; }
        if (idSilent)  param[j]="-s";
        if (Number(idClear)!=0) param=["-c"].concat(param);
        param=param.concat(defaultGP);

        if (ncpu>1) p.addAnatellaJob(s,param);
        else
        {
           rc=p.runAnatella(s,param);
           if (nRetry==5)
           {
             if (idAbortAction==2)
             {
                 if (rc>1) rc=p.runAnatella(s,param);
                 if (rc>1) rc=p.runAnatella(s,param);
                 if (rc>1) rc=p.runAnatella(s,param);
                 if (rc>1) rc=p.runAnatella(s,param);
             } else  if (idAbortAction==3)
             {
                 if (rc>=1) rc=p.runAnatella(s,param);
                 if (rc>=1) rc=p.runAnatella(s,param);
                 if (rc>=1) rc=p.runAnatella(s,param);
                 if (rc>=1) rc=p.runAnatella(s,param);
             }
           }
           handleReturnCode(rc);
        }
    }
}

function run()
{
    if (idFile&lt;0) return 1;
    if (idAbortAction>3) { idAbortAction-=2; nRetry=5; }

    p=new ProcessRunner(nRetry);
    p.setVerbose(idVerbosity);
    ncpu=Math.max(1,Number(ncpu));
    if (ncpu>70)
        throw "ERROR: Unusually high parameter for parallel execution: Are you sure that you want to execute this loop using "+ncpu+" CPU's? If yes, please remove this sanity check for the code of the Action.";
    var j,s,ss;
    var r=getNextRow();
    if (r.isNull) return 1;
    {
        s=trim(idGPV);
        if (s.length>0)
        {
            s=s.split(",");
            var i=s.length,k;
            while(i--)
            {
                k=trim(s[i]);
                if (k.length>0) 
                {
                    if (isTransient(k)) ss="-D*"+k; else ss="-D"+k;
                    defaultGP.push(ss+"="+eval(k));
                }
            }
        }
    }

    for(j=0;j&lt;idParam.length;j++) 
    {
        s=rowGetColumnName(r,idParam[j]);
        //if (isTransient(s)) s="-D*"+s; else s="-D"+s;
        names[j]="-D"+s+"=";
    }
    for(;;)
    {
        s=""+r.col(idFile);
        if (strStartsWith(s,":/")) s=currentDir+s.substr(2);
        if (fileExist(s)) launch(r,s);
        else
        {
            if (fileExist(s+".anatella")) launch(r,s+".anatella");
            else print("Warning: graph '"+s+"' does not exists");
        }
        var r=getNextRow();
        if (r.isNull) break;
    }

    if (ncpu>1) handleReturnCode(p.run(ncpu,idAbortAction));
    return 1;
}
</Script>
</Generic>
