The behavior is:&lt;ol&gt;
&lt;li&gt;NEW: Set or Update all Global Paramaters and then continue. The input table is not forwarded to the ouput.&lt;/li&gt;
&lt;li&gt;OLD: Set one Global Paramaters and directly forward the input row to the ouput&lt;/li&gt;&lt;/ol&gt;
</Description>
<Parameters>
  <Parameter id='parName' text='The Global Parameter Names' type='onecolumn'><meta>0</meta><data>gpName</data></Parameter>
  <Parameter id='parValue' text='The Global Parameter Values' type='onecolumn'><meta>0</meta><data>HORA_INICIO</data></Parameter>
  <Parameter id='setOnlyIfEmpty' text='Only set value if Global Parameter is empty' type='bool'>0</Parameter>
  <Parameter id='behavior' text='Behavior' type='combobox'><meta>&lt;i&gt;New Behavior&lt;/i&gt;&lt;i&gt;Old Behavior&lt;/i&gt;</meta><data>0</data></Parameter>
</Parameters>
<Script>
function init()
{
    var r=getCurrentRow();
    if (r.isNull) return 0;
	setOutputRowSize(0,r.nColumn);
    if (parName&lt;0) throw "Error: No column to define the \"names\" of the Global Parameters?";
    if (parValue&lt;0) throw "Error: No column to define the \"values\" of the Global Parameters?";
    if (behavior==0) return 0;
    return 0;
}

function setGP(name,r)
{
    if (parValue&lt;0)
    {
        var assign=new Function(name+"=\"\";");
        assign();
    } else
    {
        var t=""+r.col(parValue);
        t=t.replace(new RegExp("\\\\", 'g'), "\\\\");
        t=t.replace(new RegExp("\"", 'g'), "\\\"");
        t=t.replace(new RegExp("\n", 'g'), "");
        t=t.replace(new RegExp("\r", 'g'), "");
        t=name+"=\""+t+"\";"
        var assign=new Function(t);
        assign();
    }
}

function setGP2(r)
{
    var name=r.col(parName), transient=false;
    if (name[0]=='*') { name=name.substr(1); transient=true; }
    var testIfExists=new Function("return typeof("+name+");");
    var t=testIfExists();
    if (t=="undefined") { newGlobalVar(name,"",transient); setGP(name,r); return;  }
    if (t=="number") throw "Error: a global parameter NAME cannot be a number (i.e. you used \""+name+"\")";
    if (!setOnlyIfEmpty) { setGP(name,r); return; }
    var getValue=new Function("return "+name+";");
    if (getValue()!="") setGP(name,r);
}

function run()
{
    if (behavior==0)
    {
        for(;;)
        {
            var r=getNextRow();
            if (r.isNull) return 1;
            if (userAskedAbort()) return 1;
            setGP2(r);
        }
    }
    
    var r=getNextRow();
    if (r.isNull) return 1;
    r.write(); 
    writeEOL();
    setGP2(r);
    return 0;
}
</Script>
</Generic>
