<Calculator module='MathParser' idx='124' x='420' y='72'>
  <InputVars>
    <InputVar column='F.CO_RUTA' label='P_VCO_RUTA' isNumber='0'/>
    <InputVar column='F.TI_DOC_REG_FICHA' label='P_VTI_DOC_REG_FICHA' isNumber='0'/>
    <InputVar column='F.IN_ABIS' label='P_VIN_ABIS' isNumber='0'/>
    <InputVar column='F.CO_TIPO_CAPTURA' label='P_VCO_TIPO_CAPTURA' isNumber='0'/>
    <InputVar column='F.CO_TIPO_TRAMITE' label='P_VCO_TIPO_TRAMITE' isNumber='0'/>
    <InputVar column='F.CO_SUBTIPO_TRAMITE' label='P_VCO_SUBTIPO_TRAMITE' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='IN_ABIS' meta='U'>(P_VCO_RUTA="1" &amp;&amp; (P_VTI_DOC_REG_FICHA ="F" ||P_VTI_DOC_REG_FICHA="W" || P_VTI_DOC_REG_FICHA= "Z" ) ? "1":
( P_VCO_RUTA="1" &amp;&amp; nvl(P_VIN_ABIS, "0") = "1" &amp;&amp; (P_VTI_DOC_REG_FICHA="E" || P_VTI_DOC_REG_FICHA="X")? "1":
( P_VCO_RUTA = "2" &amp;&amp; nvl(P_VIN_ABIS, "0") = "1" &amp;&amp; P_VCO_TIPO_CAPTURA = "4"? "1":
( P_VCO_RUTA = "2" &amp;&amp; nvl(P_VIN_ABIS, "0") = "0" &amp;&amp; (P_VTI_DOC_REG_FICHA ="F" ||P_VTI_DOC_REG_FICHA="W" || P_VTI_DOC_REG_FICHA= "Z" ) &amp;&amp;P_VCO_TIPO_CAPTURA = "4" &amp;&amp; P_VCO_TIPO_TRAMITE = "I" ?"1":
( P_VCO_TIPO_CAPTURA = "4" &amp;&amp; P_VCO_TIPO_TRAMITE = "D" &amp;&amp; P_VCO_SUBTIPO_TRAMITE = "A" ?"1":
( P_VCO_TIPO_CAPTURA = "4" &amp;&amp; P_VCO_TIPO_TRAMITE = "R" &amp;&amp; P_VCO_SUBTIPO_TRAMITE = "R" &amp;&amp; (P_VCO_SUBTIPO_TRAMITE="C" || P_VCO_SUBTIPO_TRAMITE="D") ?"1":
"0"))))))</OutputVar>
  </OutputVars>
</Calculator>
