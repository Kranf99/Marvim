<TEXTANNOTATIONS>
  <Annotation x='-2796' y='-168' size='6' anchor='10'>IDOIMPRESION.IMTD_LOTE_IMPRESION_DNIE I</Annotation>
  <Annotation x='-2772' y='12' size='6' anchor='11'>IDOIMPRESION.IMTC_LOTE_IMPRESION_DNIE C</Annotation>
  <Annotation x='-2904' y='108' size='6' anchor='12'>IDOCAPTURA.PRTV_FICHA_REGISTRAL F</Annotation>
  <Annotation x='-2796' y='288' size='6' anchor='13'>IDOCAPTURA.PRTX_DOC_ADJUNTO_TRAMITE D</Annotation>
  <Annotation x='-672' y='456' size='6' anchor='14'>IDOTABMAESTRA.GETM_ANI U</Annotation>
  <Annotation x='-1788' y='420' size='6' anchor='16'>IDOIMPRESION.IMTV_CONTROL_PROCESO_DNIE P</Annotation>
  <Annotation x='-2616' y='-96' size='6' anchor='17'>SE FILTRA 
ES_LOTE_IMPR = &quot;1&quot;
&amp;&amp; (IN_IMPRESION = &quot;0&quot; || IN_IMPRESION =&quot;0&quot;)
&amp;&amp; (ceil(FE_FIN_IMPR) &lt;= ceil(P_DFE_DATA)
|| FE_FIN_IMPR =_null)</Annotation>
  <Annotation x='-2592' y='168' size='6' anchor='18'>SE FILTRA CON
ES_FICHA_REG = &quot;1&quot;
CO_TIPO_CATURA IN 1,2,4
IN_DNIE SEA igual a 1</Annotation>
  <Annotation x='-2484' y='-276' size='6' anchor='23'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG
Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='-2472' y='168' size='6' anchor='25'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-2616' y='336' size='6' anchor='19'>sE FILTRA CON CO_DOC_ADJ = &quot;165&quot;</Annotation>
  <Annotation x='-2460' y='324' size='6' anchor='26'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-1452' y='480' size='6' anchor='20'>SE FILTRA
CO_PROCESO = &quot;A&quot; &amp;&amp;
ceil(FE_CREA_AUDI) &lt;= P_DFE_DATA</Annotation>
  <Annotation x='-2628' y='-216' size='6' anchor='28'>sE FILTRA ES_DNI_LOTE = 1</Annotation>
  <Annotation x='-1272' y='480' size='6' anchor='27'>Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='-372' y='168' size='6' anchor='334'>SE REALIZA LEFT JOIN ENTRE LA FUENTE U Y F
POR EL CAMPO F.NU_DNI_TITULAR = U.NU_DNI</Annotation>
  <Annotation x='36' y='-12' size='6' anchor='31'>SE CREAN LOS CAMPOS A PARTIR DE VALORES CONSTANTES
IN_RECTIFICACION
IN_DNIE
IN_CANAL
IN_PRIORI_IMPR
HORA</Annotation>
  <Annotation x='1248' y='360' size='18' bold='1'>LDFU_IN_DECA</Annotation>
  <Annotation x='276' y='-36' size='6' anchor='32'>sE CREAN LOS CAMPOS
TI_DOC_REG_FICHA
FE_REGI
HORA
IM_RECIBO
FEGENERA_LOTE
FE_CADUCIDAD</Annotation>
  <Annotation x='420' y='-36' size='6' anchor='124'>SE CREA IN_ABIS
LDPK_ETL_LPROC_DNI.LDFU_IN_ABIS(F.CO_RUTA,
                                             F.TI_DOC_REG_FICHA,
                                             F.IN_ABIS,
                                             F.CO_TIPO_CAPTURA,
                                             F.CO_TIPO_TRAMITE,
                                             F.CO_SUBTIPO_TRAMITE)</Annotation>
  <Annotation x='-1500' y='576' size='6' anchor='168'>IDOIMPRESION.IMTC_INSPECCION_DNIE</Annotation>
  <Annotation x='-1200' y='660' size='6' anchor='169'>CO_ESTADO = &quot;0&quot; &amp;&amp;
