  <Annotation x='-1668' y='432' size='6' anchor='16'>IDOIMPRESION.IMTV_CONTROL_PROCESO_DNI P</Annotation>
  <Annotation x='-2208' y='-84' size='6' anchor='17'>SE FILTRA 
ceil(FE_FIN_PRE_PRENSA) &lt;= P_DFE_DATA 
&amp;&amp; (IN_IMPRESION = &quot;1&quot; || IN_IMPRESION = &quot;2&quot;)
&amp;&amp; ceil(FE_CREA_AUDI) &lt;= P_DFE_DATA</Annotation>
  <Annotation x='-2184' y='156' size='6' anchor='18'>SE FILTRA CON
ES_FICHA_REG = &quot;1&quot;
CO_TIPO_CATURA IN 1,2,4
IN_DNIE SEA VACIO o igual a 0</Annotation>
  <Annotation x='-2028' y='-288' size='6' anchor='23'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG
Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='-2052' y='156' size='6' anchor='25'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-2208' y='336' size='6' anchor='19'>sE FILTRA CON CO_DOC_ADJ = &quot;165&quot;</Annotation>
  <Annotation x='-2052' y='324' size='6' anchor='26'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-1344' y='312' size='6'>SE FILTRA
CO_PROCESO = &quot;A&quot;
FE_CREA_AUDI = P_DFE_DATA</Annotation>
  <Annotation x='-2220' y='-216' size='6' anchor='28'>sE FILTRA ES_DNI_LOTE = 1</Annotation>
  <Annotation x='-1296' y='492' size='6' anchor='27'>Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='-432' y='228' size='6' anchor='489'>SE REALIZA LEFT JOIN ENTRE LA FUENTE U Y F
POR EL CAMPO F.NU_DNI_TITULAR = U.NU_DNI
sE REALIZA INNER JOIN ENTRE LA FUENTE M Y C
POR EL CAMPO M.CO_DEST_IMPR = CO_DEST_IMPR</Annotation>
  <Annotation x='-300' y='24' size='6' anchor='31'>SE CREAN LOS CAMPOS A PARTIR DE VALORES CONSTANTES
IN_RECTIFICACION
IN_DNIE
IN_CANAL
HORA</Annotation>
  <Annotation x='432' y='432' size='18' bold='1'>LDFU_IN_DECA</Annotation>
  <Annotation x='-132' y='204' size='6' anchor='32'>SE CREAN LAS VARIABLES
TI_DOC_REG_FICHA
FE_REGI
IM_RECIBO
FE_GENERA_LOTE
FE_CADUCIDAD</Annotation>
  <Annotation x='-36' y='-12' size='6' anchor='124'>CALCULO DE IN_ABIS
LDPK_ETL_LPROC_DNI.LDFU_IN_ABIS(F.CO_RUTA,
                                             F.TI_DOC_REG_FICHA,
                                             F.IN_ABIS,
