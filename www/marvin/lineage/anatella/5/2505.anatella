  <Annotation x='-2568' y='-84' size='6' anchor='17'>SE FILTRA 
ES_LOTE_IMPR = &quot;1&quot; &amp;&amp; strlen(FE_INI_IMPR)&gt;0</Annotation>
  <Annotation x='-2544' y='264' size='6' anchor='18'>SE FILTRA CON
ES_FICHA_REG = &quot;1&quot;
CO_TIPO_CATURA IN 3
IN_DNIE SEA IGUAL 1 
CO_RUTA in 2 ó 4</Annotation>
  <Annotation x='-2388' y='-264' size='6' anchor='23'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG
Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='-2424' y='312' size='6' anchor='25'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-2592' y='468' size='6' anchor='19'>sE FILTRA CON CO_DOC_ADJ = &quot;165&quot;</Annotation>
  <Annotation x='-2436' y='456' size='6' anchor='26'>Crea la llave fKEY
NU_FICHA_REF//&quot;-&quot;//TI_DOC_REG</Annotation>
  <Annotation x='-2544' y='168' size='6' anchor='20'>SE FILTRA
TI_SOL = &quot;A&quot; &amp;&amp; 
ceil(FE_RECEPCION) &lt;= ceil(P_DFE_DATA)</Annotation>
  <Annotation x='-2580' y='-216' size='6' anchor='28'>sE FILTRA ES_DNI_LOTE = 1 Ó 9</Annotation>
  <Annotation x='-696' y='-24' size='6' anchor='530'>SE REALIZA LEFT JOIN ENTRE LA FUENTE U Y F
POR EL CAMPO F.NU_DNI_TITULAR = U.NU_DNI
sE REALIZA INNER JOIN ENTRE LA FUENTE M Y C
POR EL CAMPO M.CO_DEST_IMPR = CO_DEST_IMPR</Annotation>
