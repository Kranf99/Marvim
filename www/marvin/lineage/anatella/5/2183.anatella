    <OutputVar name='IN_RECTIFICACION' meta='U'>"SI"</OutputVar>
    <OutputVar name='IN_DNIE' meta='U' update='1'>nvl(IN_DNIE,"0")</OutputVar>
    <OutputVar name='P_DFE_DATA' meta='U'>E_FE_CREA_AUDI</OutputVar>
    <OutputVar name='CO_CONTINENTE_DOMICILIO' meta='U' update='1'>U_CO_CONTINENTE_DOMICILIO</OutputVar>
    <OutputVar name='CO_PAIS_DOMICILIO' meta='U' update='1'>U_CO_PAIS_DOMICILIO</OutputVar>
