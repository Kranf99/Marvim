    <OutputVar name='CO_SERV_CAPTURA' meta='U'>US_CREA_AUDI</OutputVar>
    <OutputVar name='IN_CANAL' meta='U'>"0"//itoa(C_TIPO_CLIENTE)</OutputVar>
    <OutputVar name='FE_REGI' meta='U' update='1'>substr(FE_REGI,0,8)</OutputVar>
    <OutputVar name='HORA' meta='U'>substr(E_FE_CREA_AUDI,9,2)</OutputVar>
    <OutputVar name='IM_RECIBO' meta='U'>nvl(D_IM_DOC_ADJ,"0")</OutputVar>
    <OutputVar name='FE_ENVIO_PROC' meta='U'>isNull(FEE_V_DFE_DATA)?_nullS:FEE_V_DFE_DATA</OutputVar>
    <OutputVar name='FE_RECE_PROC' meta='U'>isNull(FER_V_DFE_DATA)?_nullS:FER_V_DFE_DATA</OutputVar>
    <OutputVar name='CO_SERVIDOR' meta='U'>US_CREA_AUDI</OutputVar>
    <OutputVar name='IN_DECA'>(NU_FICHA_REG>=IND_NU_FICHA_INI &amp;&amp; NU_FICHA_REG&lt;=IND_NU_FICHA_FIN)?1:0</OutputVar>
    <OutputVar name='IN_HISTORICO' meta='U'>"1"</OutputVar>
    <OutputVar name='FE_APROB_PROC' meta='U'>isNull(FEA_V_DFE_DATA)?_nullS:FEA_V_DFE_DATA</OutputVar>
    <OutputVar name='FE_CADUCIDAD' meta='U'>substr(U_FE_CADUCIDAD,0,8)</OutputVar>
  </OutputVars>
