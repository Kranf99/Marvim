  <Annotation x='-1272' y='120' size='10' anchor='151'>CASE
  WHEN F.CO_TIPO_TRAMITE = &apos;I&apos; THEN
   F.CO_ESTADO_CIVIL
 ELSE
U.CO_ESTADO_CIVIL
END CO_ESTADO_CIVIL,
CASE
 WHEN F.CO_TIPO_TRAMITE = &apos;I&apos; THEN
F.CO_NIVEL_EDUCA
ELSE
 U.CO_NIVEL_EDUCA
END CO_GRADO_INSTRUCCION,
U.CO_RESTRI CO_RESTRICCION,
CASE
WHEN F.CO_TIPO_TRAMITE = &apos;I&apos; THEN
F.IN_DON_ORG
ELSE
U.IN_DONA_ORGANO
END IN_DONA_ORGANO,</Annotation>
