<Calculator keyHD='169170475204448212' module='MathParser' idx='250' x='2772' y='372'>
  <InputVars>
    <InputVar column='V_VCO_TIPO_CAPTURA' isNumber='0'/>
    <InputVar column='LDFU_IN_MPV' isNumber='0'/>
    <InputVar column='W.NU_DNI_SVB' label='W_NU_DNI_SVB' isNumber='0'/>
    <InputVar column='V_VIN_ABIS' isNumber='0'/>
    <InputVar column='W.TI_TRAMITE' label='P_VCO_TIPO_TRAMITE' isNumber='0'/>
    <InputVar column='V_VIN_DECA_AUX' label='P_VDE_VALOR' isNumber='0'/>
    <InputVar column='W.IN_RECTIFICACION' label='W_IN_RECTIFICACION' isNumber='0'/>
    <InputVar column='W.CO_SUBTIPO_TRAMITE' label='W_CO_SUBTIPO_TRAMITE' isNumber='0'/>
    <InputVar column='V_DFE_REGI' isNumber='0'/>
    <InputVar column='W.FE_TRAMITE_WEB' label='W_FE_TRAMITE_WEB' isNumber='0'/>
    <InputVar column='W.IN_RECTIFICACION' label='P_VIN_RECTIFICACION' isNumber='0'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='V_VCO_TIPO_CAPTURA' meta='U' update='1'>(V_VCO_TIPO_CAPTURA="1"?
	(LDFU_IN_MPV="1"?"3":"1"):V_VCO_TIPO_CAPTURA)</OutputVar>
    <OutputVar name='V_VIN_RECTIFICACION' meta='U'>(V_VCO_TIPO_CAPTURA="1"?
	(LDFU_IN_MPV="1"?"MP":"NN"):
	(V_VCO_TIPO_CAPTURA="3"?W_IN_RECTIFICACION:"SI"))</OutputVar>
    <OutputVar name='V_VIN_CANAL' meta='U'>(V_VCO_TIPO_CAPTURA="1"?
	(LDFU_IN_MPV="1"?"0"//itoa(C_TIPO_WEB):"0"//itoa(C_TIPO_MANUAL)):
	(V_VCO_TIPO_CAPTURA="3"?
		(W_CO_SUBTIPO_TRAMITE="2"?"0"//itoa(C_TIPO_WEB):
			(W_CO_SUBTIPO_TRAMITE="N"?"0"//itoa(C_TIPO_BN):
				(W_CO_SUBTIPO_TRAMITE="W"?"0"//itoa(C_TIPO_PVM):
					(W_CO_SUBTIPO_TRAMITE="Y"?"0"//itoa(C_TIPO_MOVIL):
						(W_CO_SUBTIPO_TRAMITE="V"?
							(W_NU_DNI_SVB= _nullS?
								"0"//itoa(C_TIPO_WEB):
								"0"//itoa(C_TIPO_PVM)):
							_nullS)
						)
					)
				)
			)
		)
		:"0"//itoa(C_TIPO_CLIENTE)
)</OutputVar>
    <OutputVar name='V_VIN_ABIS' meta='U' update='1'>(V_VCO_TIPO_CAPTURA="1"?V_VIN_ABIS:
(V_VCO_TIPO_CAPTURA="3"?(P_VDE_VALOR != _nullS ?(P_VDE_VALOR != "0" ?
		"1":
		"0"):
	(P_VCO_TIPO_TRAMITE= "D"?
		"0":
		(P_VCO_TIPO_TRAMITE = "R"?
			(nvl(P_VIN_RECTIFICACION, "00") != "07" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "08" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "09" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "10" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "11" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "12" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "13" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "14"?
				"0":
				_nullS):
			_nullS)))):V_VIN_ABIS)</OutputVar>
    <OutputVar name='V_DFE_REGI' meta='U' update='1'>(V_VCO_TIPO_CAPTURA="3"?left(W_FE_TRAMITE_WEB,8):V_DFE_REGI)</OutputVar>
  </OutputVars>
</Calculator>
