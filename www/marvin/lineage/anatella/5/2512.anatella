<TEXTANNOTATIONS>
  <Annotation x='-2556' y='288' size='6' anchor='16'>IDOIMPRESION.IMTV_CONTROL_PROCESO_DNI P</Annotation>
  <Annotation x='-2208' y='348' size='6' anchor='20'>SE FILTRA
P.CO_PROCESO = &apos;A&apos;
         AND P.CO_SUBPROCESO = &apos;08&apos;
         AND P.NU_MOVI = &apos;1&apos;
         AND P.ES_DNI_PROC IN (&apos;0&apos;,&apos;1&apos;)</Annotation>
  <Annotation x='-2028' y='348' size='6' anchor='27'>Crea la llave fKEY2
NU_LOTE//&quot;-&quot;//NU_DNI</Annotation>
  <Annotation x='1668' y='648' size='18' bold='1'>Calculo de la variable V_VIN_DECA
usando la función de 
LDFU_IN_DECA</Annotation>
  <Annotation x='-2232' y='456' size='6'>Se toman los que no coinciden</Annotation>
  <Annotation x='-2508' y='516' size='6' anchor='178'>IDOIMPRESION.IMTD_LOTE_IMPRESION</Annotation>
  <Annotation x='-2760' y='636' size='6' anchor='182'>IDOIMPRESION.IMTC_LOTE_IMPRESION</Annotation>
  <Annotation x='-2760' y='732' size='6' anchor='183'>IDOIMPRESION.IMTM_DESTINO_IMPRESION</Annotation>
  <Annotation x='-1680' y='876' size='6' anchor='190'>IDOCAPTURA.PRTV_FICHA_REGISTRAL</Annotation>
  <Annotation x='-1668' y='960' size='6' anchor='191'>IDOCAPTURA.PRTX_DOC_ADJUNTO_TRAMITE</Annotation>
  <Annotation x='-2160' y='576' size='6' anchor='179'>ES_DNI_LOTE=&quot;1&quot;</Annotation>
  <Annotation x='-2412' y='696' size='6' anchor='184'>ES_LOTE_IMPR = &quot;1&quot;</Annotation>
  <Annotation x='-1884' y='576' size='6' anchor='246'>Se renombran los cmapos por 
V_VNU_FICHA_REG
V_VTI_DOC_REG_FICHA</Annotation>
  <Annotation x='-1896' y='168' size='6' anchor='177'>sE RENOMBRA EL CAMPO
us_crea_audi --&gt; co_servidor</Annotation>
  <Annotation x='-2064' y='756' size='6' anchor='248'>se realiza trunc a la variable FE_CREA_AUDI</Annotation>
  <Annotation x='-1872' y='780' size='6' anchor='247'>Se renombran los campos
V_VIN_PRIORI_IMPR
V_VCO_GRUPO_IMPRESION
V_DFE_GENERA_LOTE
V_VCO_LOCAL_IMPRESION</Annotation>
  <Annotation x='-1200' y='876' size='6' anchor='193'>nvl(IN_DNIE,&quot;0&quot;) = &quot;0&quot; &amp;&amp; ES_FICHA_REG= &quot;1&quot;</Annotation>
  <Annotation x='-1200' y='972' size='6' anchor='192'>CO_DOC_ADJ=&quot;165&quot;</Annotation>
  <Annotation x='-1056' y='816' size='6' anchor='203'>Se pone el prefijo F.</Annotation>
  <Annotation x='-1056' y='1020' size='6' anchor='204'>Se adiciona el prefijo D.</Annotation>
  <Annotation x='-1296' y='1068' size='6' anchor='205'>LDFU_FE_ENVIO</Annotation>
  <Annotation x='-1308' y='1188' size='6' anchor='209'>LDFU_FE_RECE_PROC</Annotation>
  <Annotation x='-1320' y='1272' size='6' anchor='213'>LDFU_FE_APROB_PROC</Annotation>
  <Annotation x='-1320' y='1380' size='6' anchor='217'>LDFU_FE_ACT_ANI</Annotation>
  <Annotation x='-192' y='660' size='6' anchor='226'>Calculo de la variable 
LDFU_IN_MPV</Annotation>
  <Annotation x='-204' y='780' size='6' anchor='233'>Calculo de la variable
LDFU_GET_ORIGEN_IMPR</Annotation>
  <Annotation x='-516' y='972' size='6' anchor='220'>Se actualiza la variable proveniente de LDFU_FE_APROB_PROC
Se calcula V_VIN_ABIS
	LDPK_ETL_LPROC_DNI.LDFU_IN_ABIS(F.CO_RUTA,
                                           F.TI_DOC_REG_FICHA,
                                           F.IN_ABIS,
                                           F.CO_TIPO_CAPTURA,
                                           F.CO_TIPO_TRAMITE,
                                           F.CO_SUBTIPO_TRAMITE)
V_DFE_REGI ..&gt; left(F_FE_REGI,8)
V_NIM_RECIBO --&gt; nvl(D_IM_DOC_ADJ, 0)</Annotation>
  <Annotation x='-180' y='876' size='6' anchor='221'>Se renombran los campos acorde a la estructura</Annotation>
  <Annotation x='2772' y='252' size='6' anchor='250'>Actualización del campo
 V_VCO_TIPO_CAPTURA
V_VDFE_REGI
V_VIN_ABIS
Se crean las variables
V_VIN_RECTIFICACION
V_VIN_CANAL</Annotation>
