  <Annotation x='3216' y='684' size='6' anchor='253'>IDOTABMAESTRA.GETM_ANI</Annotation>
  <Annotation x='3360' y='684' size='6' anchor='257'>FE_CADUCIDAD</Annotation>
  <Annotation x='3456' y='672' size='6' anchor='258'>Se crean las variables
V_VDE_GENERO,
            V_VCO_CONTINENTE_D,
            V_VCO_PAIS,
            V_VCO_DEPARTAMENTO_D,
            V_VCO_PROVINCIA_D,
