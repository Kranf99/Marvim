    <InputVar column='D.IM_DOC_ADJ' label='D_IM_DOC_ADJ' isNumber='0' meta='F'/>
  </InputVars>
  <OutputVars>
    <OutputVar name='V_DFE_RECE_PROC' meta='U' update='1'>(P_VCO_RUTA = "1" || P_VCO_RUTA="2"?V_DFE_RECE_PROC:_nullS)</OutputVar>
    <OutputVar name='V_VIN_ABIS' meta='U'>(P_VCO_TIPO_CAPTURA="3"?_nullS:(P_VCO_RUTA="1" &amp;&amp; (P_VTI_DOC_REG_FICHA ="F" ||P_VTI_DOC_REG_FICHA="W" || P_VTI_DOC_REG_FICHA= "Z" ) ? "1":
( P_VCO_RUTA="1" &amp;&amp; nvl(P_VIN_ABIS, "0") = "1" &amp;&amp; (P_VTI_DOC_REG_FICHA="E" || P_VTI_DOC_REG_FICHA="X")? "1":
( P_VCO_RUTA = "2" &amp;&amp; nvl(P_VIN_ABIS, "0") = "1" &amp;&amp; P_VCO_TIPO_CAPTURA = "4"? "1":
( P_VCO_RUTA = "2" &amp;&amp; nvl(P_VIN_ABIS, "0") = "0" &amp;&amp; (P_VTI_DOC_REG_FICHA ="F" ||P_VTI_DOC_REG_FICHA="W" || P_VTI_DOC_REG_FICHA= "Z" ) &amp;&amp;P_VCO_TIPO_CAPTURA = "4" &amp;&amp; P_VCO_TIPO_TRAMITE = "I" ?"1":
( P_VCO_TIPO_CAPTURA = "4" &amp;&amp; P_VCO_TIPO_TRAMITE = "D" &amp;&amp; P_VCO_SUBTIPO_TRAMITE = "A" ?"1":
( P_VCO_TIPO_CAPTURA = "4" &amp;&amp; P_VCO_TIPO_TRAMITE = "R" &amp;&amp; P_VCO_SUBTIPO_TRAMITE = "R" &amp;&amp; (P_VCO_SUBTIPO_TRAMITE="C" || P_VCO_SUBTIPO_TRAMITE="D") ?"1":
"0")))))))</OutputVar>
    <OutputVar name='V_DFE_REGI' meta='U'>left(F_FE_REGI,8)</OutputVar>
    <OutputVar name='V_NIM_RECIBO' meta='U'>nvl(D_IM_DOC_ADJ, "0")</OutputVar>
  </OutputVars>
</Calculator>
