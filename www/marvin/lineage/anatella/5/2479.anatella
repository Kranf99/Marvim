    <OutputVar name='V_VIN_CANAL' meta='U'>(V_VCO_TIPO_CAPTURA="1"?
	(LDFU_IN_MPV="1"?"0"//itoa(C_TIPO_WEB):"0"//itoa(C_TIPO_MANUAL)):
	(V_VCO_TIPO_CAPTURA="3"?
		(W_CO_SUBTIPO_TRAMITE="2"?"0"//itoa(C_TIPO_WEB):
			(W_CO_SUBTIPO_TRAMITE="N"?"0"//itoa(C_TIPO_BN):
				(W_CO_SUBTIPO_TRAMITE="W"?"0"//itoa(C_TIPO_PVM):
					(W_CO_SUBTIPO_TRAMITE="Y"?"0"//itoa(C_TIPO_MOVIL):
						(W_CO_SUBTIPO_TRAMITE="V"?
							(W_NU_DNI_SVB= _nullS?
								"0"//itoa(C_TIPO_WEB):
								"0"//itoa(C_TIPO_PVM)):
							_nullS)
						)
					)
				)
			)
		)
		:"0"//itoa(C_TIPO_CLIENTE)
)</OutputVar>
    <OutputVar name='V_VIN_ABIS' meta='U' update='1'>(V_VCO_TIPO_CAPTURA="1"?V_VIN_ABIS:
(V_VCO_TIPO_CAPTURA="3"?(P_VDE_VALOR != _nullS ?(P_VDE_VALOR != "0" ?
		"1":
		"0"):
	(P_VCO_TIPO_TRAMITE= "D"?
		"0":
		(P_VCO_TIPO_TRAMITE = "R"?
			(nvl(P_VIN_RECTIFICACION, "00") != "07" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "08" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "09" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "10" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "11" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "12" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "13" &amp;&amp; nvl(P_VIN_RECTIFICACION, "00") != "14"?
				"0":
				_nullS):
			_nullS)))):V_VIN_ABIS)</OutputVar>
    <OutputVar name='V_DFE_REGI' meta='U' update='1'>(V_VCO_TIPO_CAPTURA="3"?left(W_FE_TRAMITE_WEB,8):V_DFE_REGI)</OutputVar>
